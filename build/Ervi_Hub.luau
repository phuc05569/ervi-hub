__sources["Scope"] = function(require) -- src/Scope.luau
-- Scope: owns cleanup for connections, instances, threads, callbacks and child scopes.
-- close() is idempotent and disposes in reverse order; anything added after close is disposed at once.
local Scope = {}
Scope.__index = Scope

local log = warn or print

function Scope.new(name)
	return setmetatable({ name = name or "scope", items = {}, closed = false }, Scope)
end

local function dispose(item)
	local kind = typeof(item)
	if kind == "RBXScriptConnection" then
		item:Disconnect()
	elseif kind == "Instance" then
		item:Destroy()
	elseif kind == "function" then
		item()
	elseif kind == "thread" then
		if coroutine.running() == item then
			return -- a thread cannot cancel itself; it ends on its own once its scope is closed
		end
		if task then
			pcall(task.cancel, item)
		else
			pcall(coroutine.close, item)
		end
	elseif kind == "table" then
		if item.close then
			item:close()
		elseif item.Disconnect then
			item:Disconnect()
		elseif item.Destroy then
			item:Destroy()
		end
	end
end

function Scope:add(item)
	if self.closed then
		pcall(dispose, item)
		return item
	end
	table.insert(self.items, item)
	return item
end

function Scope:connect(signal, fn)
	return self:add(signal:Connect(fn))
end

function Scope:child(name)
	return self:add(Scope.new(name))
end

function Scope:close()
	if self.closed then
		return
	end
	self.closed = true
	local items = self.items
	self.items = {}
	for i = #items, 1, -1 do
		local ok, err = pcall(dispose, items[i])
		if not ok then
			log(("[Ervi Hub] cleanup error in %s: %s"):format(self.name, tostring(err)))
		end
	end
end

return Scope
end
__sources["Rarity"] = function(require) -- src/Rarity.luau
-- Rarity rules mirrored from the game's AttackData.Tier (CONFIGURED, placeVersion 969 decompile).
-- Chance is the "1 in N" denominator: larger = rarer. Live tiers replace the fallback when AttackData loads.
local Rarity = {}

Rarity.FALLBACK_TIERS = {
	{ Max = 3, Name = "Common" },
	{ Max = 5, Name = "Uncommon" },
	{ Max = 8, Name = "Rare" },
	{ Max = 12, Name = "Epic" },
	{ Max = math.huge, Name = "Legendary" },
}

-- The game's own "You will lose X" confirm appears when the equipped Chance is above this.
Rarity.GAME_CONFIRM_ABOVE = 125

function Rarity.tierName(chance, tiers, style)
	if style and style.RarityColor and style.RarityName then
		return style.RarityName
	end
	tiers = tiers or Rarity.FALLBACK_TIERS
	if type(chance) ~= "number" then
		return "?"
	end
	for _, tier in ipairs(tiers) do
		if chance <= tier.Max then
			return tier.Name
		end
	end
	return tiers[#tiers].Name
end

-- target = { mode = "chance", min = N }  -> qualifies when chance >= N
-- target = { mode = "style", names = { [name] = true } } -> qualifies on exact name
function Rarity.validTarget(target)
	if type(target) ~= "table" then
		return false
	end
	if target.mode == "chance" then
		return type(target.min) == "number" and target.min >= 1
	elseif target.mode == "style" then
		return type(target.names) == "table" and next(target.names) ~= nil
	end
	return false
end

function Rarity.qualifies(target, name, chance)
	if type(name) ~= "string" then
		return false
	end
	if target.mode == "chance" then
		return type(chance) == "number" and chance >= target.min
	elseif target.mode == "style" then
		return target.names[name] == true
	end
	return false
end

function Rarity.describe(target)
	if target.mode == "chance" then
		return ("odds 1/%d or rarer (Chance >= %d)"):format(target.min, target.min)
	end
	local names = {}
	for name in pairs(target.names) do
		table.insert(names, name)
	end
	table.sort(names)
	return "exact style: " .. table.concat(names, ", ")
end

return Rarity
end
__sources["AutoRoll"] = function(require) -- src/AutoRoll.luau
-- AutoRoll: cancellable "roll until target" state machine. Pure logic; all game access goes through `adapter`.
--
-- Adapter contract (see RollAdapter.luau for the live game implementation):
--   now() -> seconds            wait(dt)                spawn(fn)
--   canRoll() -> ok, reason, recoverable (known temporary game gates may wait indefinitely)
--   readyAt() -> any             (RollReadyAt attribute; used to confirm the server started a new cooldown)
--   currentStyle() -> {name, chance} | nil
--   requestRoll() -> handle       handle.done / handle.name / handle.chance / handle.err filled asynchronously
--   chanceOf(name) -> number|nil  tierOf(name, chance) -> string
--
-- Invariants (covered by tests/AutoRoll.spec.luau):
--   * at most one roll request in flight, never retried automatically;
--   * a qualifying result (current, normal, late, or after Stop) ends the run with zero further requests;
--   * timeouts, empty results and unconfirmed cooldowns pause instead of rolling again.
local Rarity = require("Rarity")

local AutoRoll = {}
AutoRoll.__index = AutoRoll

local RUNNING = { Checking = true, WaitingReady = true, WaitingRespawn = true, Requesting = true, Confirming = true }

AutoRoll.DEFAULTS = {
	maxRolls = math.huge,
	requestTimeout = 12,
	readyTimeout = 180,
	acceptTimeout = 3,
	lateWatch = 60,
	pauseOnRare = false,
	rareAbove = Rarity.GAME_CONFIRM_ABOVE,
	requireCooldownAdvance = true,
	poll = 0.1,
	resumeAfterDeath = false,
}

local function styleLabel(name, chance)
	return ("%s (1/%s)"):format(tostring(name), chance and tostring(chance) or "?")
end

function AutoRoll.new(adapter, opts)
	local self = setmetatable({}, AutoRoll)
	self.a = adapter
	self.opts = {}
	for k, v in pairs(AutoRoll.DEFAULTS) do
		self.opts[k] = v
	end
	for k, v in pairs(opts or {}) do
		self.opts[k] = v
	end
	self.state, self.reason = "Idle", "Not started"
	self.gen = 0
	self.pending = nil
	self.history = {}
	self.listeners = {}
	self:resetStats()
	return self
end

function AutoRoll:resetStats()
	self.stats = { attempted = 0, confirmed = 0, startedAt = nil }
	self.last = nil
end

function AutoRoll:onChange(fn)
	table.insert(self.listeners, fn)
end

function AutoRoll:isRunning()
	return RUNNING[self.state] == true
end

function AutoRoll:_set(state, reason)
	if self.state == state and self.reason == reason then
		return
	end
	self.state, self.reason = state, reason or ""
	for _, fn in ipairs(self.listeners) do
		local ok, err = pcall(fn, self)
		if not ok then
			(warn or print)("[Ervi Hub] AutoRoll listener error: " .. tostring(err))
		end
	end
end

-- opts.acceptRare: user confirmed rolling away a rare current style. opts.keepStats: Continue after a pause.
function AutoRoll:start(target, opts)
	opts = opts or {}
	if self:isRunning() then
		return false, "Already running"
	end
	if self.pending and not self.pending.done then
		return false, "The previous roll has not answered yet; waiting for it first"
	end
	if not Rarity.validTarget(target) then
		return false, "Pick a valid target first"
	end
	self.gen += 1
	local gen = self.gen
	self.target = target
	if not opts.keepStats then
		self:resetStats()
	end
	self.stats.startedAt = self.stats.startedAt or self.a.now()
	self.a.spawn(function()
		self:_run(gen, opts.acceptRare == true)
	end)
	return true
end

function AutoRoll:stop(reason)
	if not self:isRunning() then
		return false
	end
	self.gen += 1
	self:_set("Idle", reason or "Stopped by user")
	return true
end

-- Hub closing: stop, drop UI listeners, and make any late-result watcher a no-op.
function AutoRoll:dispose()
	self:stop("Hub closed")
	self.disposed = true
	self.gen += 1
	self.listeners = {}
end

function AutoRoll:_live(gen)
	return self.gen == gen
end

function AutoRoll:_end(gen, state, reason)
	if self.gen == gen then
		self.gen += 1
		self:_set(state, reason)
	end
end

function AutoRoll:_found(text)
	self.gen += 1 -- kills any loop still running
	self:_set("Found", text)
end

-- Records a finished handle. Returns "found" | "ok" | "bad", message.
function AutoRoll:_evaluate(handle)
	if handle.err then
		return "bad", "Roll request failed: " .. tostring(handle.err)
	end
	local name, chance = handle.name, handle.chance
	if type(name) ~= "string" then
		return "bad", "Server returned no result (the game shows TRY AGAIN). Paused."
	end
	if type(chance) ~= "number" then
		chance = self.a.chanceOf(name)
	end
	self.stats.confirmed += 1
	self.last = {
		name = name,
		chance = chance,
		tier = self.a.tierOf(name, chance),
		at = self.a.now(),
		n = self.stats.attempted,
	}
	table.insert(self.history, 1, self.last)
	if #self.history > 50 then
		table.remove(self.history)
	end
	if Rarity.qualifies(self.target, name, chance) then
		return "found", ("Got %s on roll #%d - target met. Stopped; no further rolls."):format(
			styleLabel(name, chance),
			self.stats.attempted
		)
	end
	return "ok", nil
end

function AutoRoll:_watchLate(handle)
	local a = self.a
	a.spawn(function()
		local t0 = a.now()
		while not handle.done and a.now() - t0 < self.opts.lateWatch do
			a.wait(0.25)
		end
		if not handle.done or self.disposed then
			return
		end
		local verdict, text = self:_evaluate(handle)
		if verdict == "found" then
			self:_found(text .. " (late server response)")
		elseif verdict == "ok" and not self:isRunning() then
			self:_set(self.state, self.reason .. " | Late result: " .. styleLabel(self.last.name, self.last.chance))
		end
	end)
end

function AutoRoll:_run(gen, acceptRare)
	local a, o = self.a, self.opts

	self:_set("Checking", "Checking your current style")
	local cur = a.currentStyle()
	if cur and Rarity.qualifies(self.target, cur.name, cur.chance) then
		return self:_end(gen, "Found", ("Your current %s already meets the target. No roll sent."):format(styleLabel(cur.name, cur.chance)))
	end
	if cur and o.pauseOnRare and not acceptRare and type(cur.chance) == "number" and cur.chance > o.rareAbove then
		return self:_end(
			gen,
			"Paused",
			("Your current %s is rarer than 1/%d. Press Continue to roll it away."):format(styleLabel(cur.name, cur.chance), o.rareAbove)
		)
	end

	while self:_live(gen) do
		if self.stats.attempted >= o.maxRolls then
			return self:_end(gen, "Paused", ("Roll cap reached (%d). Raise it in options to continue."):format(o.maxRolls))
		end

		-- 1. Wait for the same preconditions the game's own roll button checks.
		local since = a.now()
		self:_set("WaitingReady", "Waiting for roll readiness")
		while true do
			if not self:_live(gen) then
				return
			end
			local ok, why, recoverable = a.canRoll()
			if ok then
				break
			end
			local dead = a.alive and not a.alive()
			if dead and not o.resumeAfterDeath then
				return self:_end(gen, "Paused", "Character died; enable Resume Auto Roll After Death to wait for respawn")
			end
			if dead then
				since = a.now() -- death does not consume the live-readiness timeout
				self:_set("WaitingRespawn", "Waiting for respawn; selected target retained")
			elseif recoverable then
				since = a.now() -- known temporary gates retain this run, without sending requests
			elseif a.now() - since >= o.readyTimeout then
				return self:_end(gen, "Paused", ("Not ready for %ds: %s"):format(o.readyTimeout, tostring(why)))
			end
			if not dead then self:_set("WaitingReady", "Waiting — rolling unavailable · " .. tostring(why or "Waiting")) end
			a.wait(o.poll)
		end

		-- Recheck replicated equipment after a long readiness/respawn wait.
		local current = a.currentStyle()
		if current and Rarity.qualifies(self.target, current.name, current.chance) then
			return self:_end(gen, "Found", "Current style meets the target after waiting; no roll sent")
		end
		if current and o.pauseOnRare and not acceptRare and type(current.chance) == "number" and current.chance > o.rareAbove then
			return self:_end(gen, "Paused", "Current style changed to a rare style; Continue required")
		end
		acceptRare = false

		-- 2. Exactly one request, awaited with a timeout and never retried.
		local readyBefore = a.readyAt()
		self:_set("Requesting", ("Preparing roll #%d"):format(self.stats.attempted + 1))
		if not self:_live(gen) then return end -- a listener may have requested Stop
		local handle = a.requestRoll()
		if handle.notSent then
			if not self:_live(gen) then return end
			if not handle.recoverable then return self:_end(gen, "Paused", handle.reason or "Roll unavailable") end
			self:_set("WaitingReady", "Waiting — rolling unavailable · " .. tostring(handle.reason))
			a.wait(o.poll)
			continue -- preflight refused locally; no request exists to retry
		end
		self.stats.attempted += 1
		self.pending = handle
		if self:_live(gen) then self:_set("Requesting", ("Roll #%d sent - waiting for the server result"):format(self.stats.attempted)) end
		local t0 = a.now()
		while not handle.done and a.now() - t0 < o.requestTimeout do
			a.wait(o.poll)
		end
		if not handle.done then
			self:_end(gen, "Paused", ("No server response after %ds. Not rolling again."):format(o.requestTimeout))
			return self:_watchLate(handle)
		end

		-- 3. Evaluate, even if Stop was pressed while waiting: a rare result must be reported.
		local verdict, text = self:_evaluate(handle)
		if verdict == "found" then
			return self:_found(text)
		elseif verdict == "bad" then
			return self:_end(gen, "Paused", text)
		end
		if not self:_live(gen) then
			return
		end

		-- 4. Confirm the server started a new cooldown before even considering another roll.
		if o.requireCooldownAdvance then
			self:_set("Confirming", "Confirming the server started the next cooldown")
			local t1 = a.now()
			while a.readyAt() == readyBefore and a.now() - t1 < o.acceptTimeout do
				if not self:_live(gen) then
					return
				end
				a.wait(o.poll)
			end
			if a.readyAt() == readyBefore then
				return self:_end(gen, "Paused", "Got a result but the roll cooldown did not restart (uncertain). Paused.")
			end
		end
		if not self:_live(gen) then
			return
		end

		local last = self.last
		if o.pauseOnRare and type(last.chance) == "number" and last.chance > o.rareAbove then
			return self:_end(
				gen,
				"Paused",
				("Got %s: rarer than 1/%d but below target. Kept it - press Continue to roll it away."):format(
					styleLabel(last.name, last.chance),
					o.rareAbove
				)
			)
		end
	end
end

return AutoRoll
end
__sources["Settings"] = function(require) -- src/Settings.luau
-- Named configs, stored as one text file in the executor workspace when readfile/writefile exist:
--   autoload=PvP
--   [Default]
--   toggleKey=RightShift
--   ...
-- Every value is validated on load; unknown keys and bad values fall back to defaults.
-- A 2.1.x file (plain key=value lines, no sections) is read into the "Default" config.
local Schema = require("FeatureSchema")
local Positions=require("PositionData")
local Settings = {}

Settings.FILE = "RNG_Hub_settings.txt"
Settings.MIN_OPACITY = 0
Settings.DEFAULT_NAME = "Default"
Settings.DEFAULTS = {
 safeZoneLocations="", savedPositions="", -- legacy position data is retained on save, without a feature/UI
	toggleKey = "RightShift",
	opacity = 0.75, -- on the slider's 5% grid
	scale = 0.85,
	theme = "Midnight",
	accent = "Indigo", -- "" = the design's own accent
	font = "Gotham",
	textColor = "White",
	textScale = 1.4,
	outline = "auto", -- auto | on | off
	textAlpha = 0,
	bgColor = "", -- "" = the design's own background, or "#RRGGBB"
	antiAfk = false,
	reconnect = false,
	autoExec = false,
	instantPrompts = false,
	winW = 880, -- window size, changed with the corner grip
	winH = 580,
	winX = 0.5, winY = 0.5,
	statusX=0.5,statusY=0.93,
	statusOpacity=0.7,
	customN=500,
	communityLink = "",
	movementX=0.1, movementY=0.3, movementW=330, movementH=240,
	m1Enabled = false,
	m1X = 0.5, m1Y = 0.55, m1W = 330, m1H = 180,
	safeZoneKey = "NONE",
	targetEnabled = false, targetHp = 30,
	resumeAfterDeath = false, autoM1Requested = false,
}
local KEYS = { "safeZoneLocations", "savedPositions", "toggleKey", "opacity", "scale", "theme", "accent", "font", "textColor", "textScale", "outline", "textAlpha", "bgColor", "antiAfk", "reconnect", "autoExec", "instantPrompts", "winW", "winH", "winX", "winY", "statusX", "statusY", "movementX", "movementY", "movementW", "movementH", "communityLink", "m1Enabled", "m1X", "m1Y", "m1W", "m1H", "safeZoneKey", "targetEnabled", "targetHp", "resumeAfterDeath", "autoM1Requested" }
local BOOLS = { antiAfk = true, reconnect = true, autoExec = true, instantPrompts = true, m1Enabled = true, targetEnabled = true, resumeAfterDeath = true, autoM1Requested = true }
local NUMBERS = { opacity = { 0, 1 }, scale = { 0.5, 1.5 }, textScale = { 0.8, 1.4 }, textAlpha = { 0, 0.6 }, winW = { 520, 1100 }, winH = { 360, 820 }, winX={0,1},winY={0,1},statusX={0,1},statusY={0,1},movementX={0,1},movementY={0,1},movementW={260,800},movementH={160,600}, m1X = {0,1}, m1Y = {0,1}, m1W = {260,800}, m1H = {160,600}, targetHp = {1,100} }

for _, d in ipairs(Schema) do
 Settings.DEFAULTS[d.key]=d.default
 table.insert(KEYS,d.key)
 if d.kind=="bool" then BOOLS[d.key]=true end
 if d.kind=="number" then NUMBERS[d.key]={d.min,d.max} end
end
local SCHEMA={}; for _,d in ipairs(Schema) do SCHEMA[d.key]=d end

local OUTLINE = { auto = true, on = true, off = true }

function Settings.defaults()
	return table.clone(Settings.DEFAULTS)
end

-- Config names: 1-24 chars of letters, digits, space, _ or -.
function Settings.cleanName(name)
	if type(name) ~= "string" then
		return nil
	end
	name = name:match("^%s*(.-)%s*$")
	if #name < 1 or #name > 24 or name:find("[^%w _%-]") then
		return nil
	end
	return name
end

-- validate[key](string) -> bool for the string-valued keys (injected so this stays testable).
local function setField(cfg, key, value, validate)
 if key=="throughWalls" then
  if not cfg._visibilityExplicit and (value=="true" or value=="false") then cfg.visibilityMode=value=="false" end
  return
 end
 if key=="visibilityMode" and (value=="true" or value=="false") then cfg._visibilityExplicit=true end
	if Settings.DEFAULTS[key] == nil then
		return
	end
	local spec=SCHEMA[key]
	if spec and spec.options and not table.find(spec.options,value) then return end
	if spec and spec.kind=="color" and not value:match("^#%x%x%x%x%x%x$") then return end
	if spec and spec.kind=="key" and value~="NONE" and (not value:match("^[A-Za-z][A-Za-z0-9]*$") or #value>24) then return end
	local range = NUMBERS[key]
	if range then
		local n = tonumber(value)
		if n and n == n and math.abs(n) < math.huge then
			cfg[key] = math.max(range[1], math.min(range[2], n))
		end
	elseif BOOLS[key] then
		if value == "true" or value == "false" then
			cfg[key] = value == "true"
		end
	elseif key == "outline" then
		if OUTLINE[value] then
			cfg[key] = value
		end
	elseif key=="safeZoneLocations" or key=="savedPositions" then
  if #value<=8192 then cfg[key]=Positions.encode(Positions.decode(value)) or "" end
	elseif #value<=300 and not value:find("[%c]") and (not validate[key] or validate[key](value)) then
		cfg[key] = value
	end
end

function Settings.newStore()
	return { autoload = nil, autoloadGames = {}, configs = {}, order = {} }
end

function Settings.put(store, name, cfg)
	if not store.configs[name] then
		table.insert(store.order, name)
	end
	store.configs[name] = cfg
end

function Settings.delete(store, name)
	if not store.configs[name] then
		return false
	end
	store.configs[name] = nil
	table.remove(store.order, table.find(store.order, name))
	for place,slot in pairs(store.autoloadGames or {}) do if slot==name then store.autoloadGames[place]=nil end end
	if store.autoload == name then
		store.autoload = nil
	end
	return true
end

function Settings.parse(text, validate)
	local store = Settings.newStore()
	if type(text) ~= "string" or #text>1048576 then
		return store
	end
	local current, skipping = nil, false
	for line in (text .. "\n"):gmatch("([^\n]*)\n") do
		line = (line:gsub("\r$", ""))
		local section = line:match("^%[(.*)%]$")
		if section then
			local name = Settings.cleanName(section)
			skipping = name == nil
			if name and not store.configs[name] then
				Settings.put(store, name, Settings.defaults())
			end
			current = name and store.configs[name]
		else
			local key, value = line:match("^([%w_]+)=(.*)$")
			if key and not skipping then
				if current then
					setField(current, key, value, validate)
				elseif key:match("^autoloadGame_%d+$") then
                    store.autoloadGames[key:match("%d+$")]=Settings.cleanName(value)
				elseif key == "autoload" then
					store.autoload = Settings.cleanName(value)
				else
					if not store.configs[Settings.DEFAULT_NAME] then
						Settings.put(store, Settings.DEFAULT_NAME, Settings.defaults())
					end
					setField(store.configs[Settings.DEFAULT_NAME], key, value, validate)
				end
			end
		end
	end
	for place,name in pairs(store.autoloadGames) do if not store.configs[name] then store.autoloadGames[place]=nil end end
	for _, cfg in pairs(store.configs) do
        cfg._visibilityExplicit=nil
		if cfg.safeZoneKey == cfg.toggleKey then cfg.safeZoneKey = "NONE" end
        local used={[cfg.toggleKey]=true}
        for _,key in ipairs({"safeZoneKey","panicKey","walkKey","espKey","flyKey","noclipKey","clickTPKey","diagnosticKey"}) do
            if cfg[key]~="NONE" then if used[cfg[key]] then cfg[key]="NONE" else used[cfg[key]]=true end end
        end
	end
	if store.autoload and not store.configs[store.autoload] then
		store.autoload = nil
	end
	return store
end

function Settings.serialize(store)
	local out = {}
    local places={};for place in pairs(store.autoloadGames or {}) do table.insert(places,place) end;table.sort(places)
    for _,place in ipairs(places) do table.insert(out,"autoloadGame_"..place.."="..store.autoloadGames[place]) end
	if store.autoload then
		table.insert(out, "autoload=" .. store.autoload)
	end
	for _, name in ipairs(store.order) do
		local cfg = store.configs[name]
		table.insert(out, "[" .. name .. "]")
		for _, key in ipairs(KEYS) do
			local v = cfg[key]
			table.insert(out, key .. "=" .. (type(v) == "number" and (key:match("[XY]$") and ("%.6f"):format(v) or ("%.2f"):format(v)) or tostring(v)))
		end
	end
	return table.concat(out, "\n") .. "\n"
end

function Settings.canPersist()
	return type(readfile) == "function" and type(writefile) == "function"
end

function Settings.load(validate)
	if not Settings.canPersist() then
		return Settings.parse(nil, validate)
	end
	local ok, text = pcall(function()
		if type(isfile) == "function" and not isfile(Settings.FILE) then
			return nil
		end
		return readfile(Settings.FILE)
	end)
	return Settings.parse(ok and text or nil, validate)
end

-- 3.4 has no slot manager: the profile that was effective when it first ran (per-game autoload,
-- then global autoload, then Default) keeps auto-saving. Other named profiles stay in the file.
function Settings.activeName(store, placeId)
	local name = store.autoloadGames[tostring(placeId)] or store.autoload or Settings.DEFAULT_NAME
	if not store.configs[name] then
		name = Settings.DEFAULT_NAME
	end
	return name
end

-- Copies the existing settings file once, before the first 3.4 write. Never overwrites a backup.
Settings.BACKUP_FILE = "RNG_Hub_settings.pre-autosave-backup.txt"
function Settings.backupOnce()
	if not Settings.canPersist() or type(isfile) ~= "function" then
		return false, "no file access"
	end
	return pcall(function()
		if isfile(Settings.FILE) and not isfile(Settings.BACKUP_FILE) then
			writefile(Settings.BACKUP_FILE, readfile(Settings.FILE))
		end
	end)
end

function Settings.save(store)
	if not Settings.canPersist() then
		return false, "this executor has no file access"
	end
	return pcall(writefile, Settings.FILE, Settings.serialize(store))
end

-- Share a single slot as a bounded data-only envelope; never loadstring config text.
function Settings.export(cfg)
 local one=Settings.newStore(); Settings.put(one,"Imported",cfg)
 return "ERVI_CONFIG_V1\n"..Settings.serialize(one)
end
function Settings.import(text,validate)
 if type(text)~="string" or #text>65536 then return nil,"Import is missing or larger than 64 KiB" end
 if text:sub(1,15)~="ERVI_CONFIG_V1\n" then return nil,"Unsupported config version" end
 local parsed=Settings.parse(text:sub(16),validate or {})
 if #parsed.order~=1 then return nil,"Import must contain exactly one slot" end
 return parsed.configs[parsed.order[1]]
end
return Settings
end
__sources["WindowGeometry"] = function(require) -- src/WindowGeometry.luau
-- Pixel layout with normalized top-left placement; survives viewport changes.
local Geometry = {}
function Geometry.fit(saved: {w:number,h:number,x:number,y:number}, vw:number, vh:number)
 vw = math.max(1, vw - 16)
 vh = math.max(1, vh - 48)
 local w = math.clamp(saved.w, math.min(260, vw), math.min(800, vw))
 local h = math.clamp(saved.h, math.min(160, vh), math.min(600, vh))
 return { w=w, h=h, x=math.clamp(saved.x,0,1)*math.max(0,vw-w), y=math.clamp(saved.y,0,1)*math.max(0,vh-h), vw=vw, vh=vh }
end
function Geometry.move(rect, x, y)
 rect.x=math.clamp(x,0,math.max(0,rect.vw-rect.w)); rect.y=math.clamp(y,0,math.max(0,rect.vh-rect.h))
 return rect
end
function Geometry.saved(rect)
 return {w=rect.w,h=rect.h,x=rect.vw>rect.w and rect.x/(rect.vw-rect.w) or 0,y=rect.vh>rect.h and rect.y/(rect.vh-rect.h) or 0}
end
-- Main window positions use parent pixels. Its own UIScale affects size, not its center.
function Geometry.mainAnchor(w,h,scale,vw,vh,x,y)
 local hx=math.min(0.5,(w*scale/2+8)/math.max(1,vw))
 local hy=math.min(0.5,(h*scale/2+8)/math.max(1,vh))
 return math.clamp(x,hx,1-hx),math.clamp(y,hy,1-hy)
end
return Geometry
end
