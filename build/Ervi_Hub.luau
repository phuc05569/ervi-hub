    c.characterScope=Scope.new("visual-rig");c.char=char;c.hum=nil;c.head=nil;c.root=nil;c.links=nil;c.dirty=true
    drop(player)
    if char then
     local function dirty() c.dirty=true end
     c.characterScope:connect(char.DescendantAdded,dirty);c.characterScope:connect(char.DescendantRemoving,dirty)
    end
   end
   bind(player.Character)
   c.scope:connect(player.CharacterAdded,bind);c.scope:connect(player.CharacterRemoving,function() bind(nil) end)
   friend(player)
  end
  for _,player in ipairs(playerService:GetPlayers()) do added(player) end
  scope:connect(playerService.PlayerAdded,added)
  scope:connect(playerService.PlayerRemoving,function(player) closeTracked(player);drop(player,true) end)
  Run:BindToRenderStep(renderName,Enum.RenderPriority.Camera.Value+1,function(dt)
   elapsed+=dt
   local cam=workspace.CurrentCamera
   local rate=Policy.rate(getPrefs().updateRate)
   if elapsed<1/rate then
    local started=os.clock();local before=visuals.projections;local ok,err=pcall(present)
    visuals.presentationFrames=(visuals.presentationFrames or 0)+1
    visuals.presentationMs=(visuals.presentationMs or 0)+(os.clock()-started)*1000
    visuals.presentationProjections=visuals.projections-before
    if not ok then visuals.stop();getPrefs().espEnabled=false;visuals.status="Rendering disabled: "..tostring(err) end
    return
   end;elapsed=elapsed%(1/rate)
   if friendMode~=getPrefs().markFriends then
    friendMode=getPrefs().markFriends
    if friendMode then for player in pairs(tracked) do friend(player) end end
   end
   local started=os.clock();local ok,err=pcall(update)
   visuals.presentationFrames=(visuals.presentationFrames or 0)+1
   local ms=(os.clock()-started)*1000;visuals.updates=(visuals.updates or 0)+1;visuals.totalMs=(visuals.totalMs or 0)+ms;visuals.maxMs=math.max(visuals.maxMs or 0,ms)
   visuals.effectiveRate=rate
   if not ok then visuals.stop();getPrefs().espEnabled=false;visuals.status="Rendering disabled: "..tostring(err) end
  end)
  scope:add(function() Run:UnbindFromRenderStep(renderName) end)
  visuals.active=true
 end
 hub:add(visuals.stop)
 return visuals
end
end
__sources["VisualPreview"] = function(require) -- src/VisualPreview.luau
-- Original native-UI mannequin; no third-party character art or asset downloads.
local Ui=require("Ui")
local Theme=require("Theme")
local TextStyle=require("VisualTextStyle")
local Stroke=require("SkeletonStroke")
return function(parent)
 local frame=Ui.card(parent,"Visualization preview",0,"Native sample · Visibility Mode filters live targets")
 local canvas=Ui.new("Frame",{Size=UDim2.new(1,0,0,270),BackgroundColor3=Color3.fromRGB(21,25,35),LayoutOrder=1,Parent=frame})
 canvas:SetAttribute("FixedBackground",true);Ui.corner(canvas,10)
 local center=Ui.new("Frame",{Size=UDim2.fromOffset(150,210),Position=UDim2.new(0.5,-75,0,26),BackgroundTransparency=1,Parent=canvas})
 local function block(name,x,y,w,h,tint)
  local obj=Ui.new("Frame",{Name=name,Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(w,h),BackgroundColor3=tint,BorderSizePixel=0,Parent=center})
  obj:SetAttribute("FixedBackground",true);Ui.corner(obj,4);return obj
 end
 local skin=Color3.fromRGB(231,208,188);local cloth=Color3.fromRGB(66,77,101)
 block("Head",59,20,32,32,skin);block("Torso",48,56,54,65,cloth)
 block("LeftArm",22,56,22,65,skin);block("RightArm",106,56,22,65,skin)
 block("LeftLeg",48,125,24,65,cloth);block("RightLeg",78,125,24,65,cloth)
 local box=Ui.new("Frame",{Position=UDim2.fromOffset(18,16),Size=UDim2.fromOffset(114,180),BackgroundTransparency=1,Parent=center})
 local boxStroke=Ui.stroke(box,Theme.accent,0)
 local corners={}
 for _,p in ipairs({{18,16,25,2},{18,16,2,25},{107,16,25,2},{130,16,2,25},{18,194,25,2},{18,171,2,25},{107,194,25,2},{130,171,2,25}}) do table.insert(corners,block("Corner",p[1],p[2],p[3],p[4],Theme.accent)) end
 local health=block("Health",12,54,3,142,Theme.good)
 local head=block("HeadDot",72,33,6,6,Theme.accent)
 local bones={};local outlines={};local boneRects={}
 for _,p in ipairs({{74,36,2,148},{32,66,86,2},{32,66,2,45},{116,66,2,45},{59,123,2,61},{89,123,2,61},{59,122,32,2}}) do
  local o=block("BoneOutline",p[1]-1,p[2]-1,p[3]+2,p[4]+2,Color3.new(0,0,0));o.ZIndex=1
  local b=block("Bone",p[1],p[2],p[3],p[4],Color3.new(1,1,1));b.ZIndex=2
  table.insert(outlines,o);table.insert(bones,b);table.insert(boneRects,p)
 end
 local name=Ui.text(canvas,"Sample player",{size=UDim2.new(1,0,0,22),textSize=12,align=Enum.TextXAlignment.Center})
 local distance=Ui.text(canvas,"58 studs",{size=UDim2.new(1,0,0,22),textSize=11,align=Enum.TextXAlignment.Center});distance.Position=UDim2.new(0,0,1,-25)
 local tracer=Ui.new("Frame",{Position=UDim2.new(0.5,0,0,0),Size=UDim2.fromOffset(1,40),BorderSizePixel=0,Parent=canvas})
 local arrow=Ui.text(canvas,"▲",{size=UDim2.fromOffset(20,20),textSize=20});arrow.Position=UDim2.new(1,-24,0.5,0)
 local fill=Ui.new("Frame",{Position=UDim2.fromOffset(48,56),Size=UDim2.fromOffset(54,65),BorderSizePixel=0,Parent=center})
 fill:SetAttribute("FixedBackground",true)
 local fillStroke=Ui.stroke(fill,Theme.accent,0)
 local state=Ui.text(frame,"",{order=2,textSize=Theme.size.tiny,color=Theme.muted})
 return {frame=frame,render=function(p,status)
  local tint=Color3.fromHex(p.enemyColor:sub(2))
  local visible=true
  box.Visible=visible and p.boxStyle=="Box";boxStroke.Color=tint
  for _,c in ipairs(corners) do c.Visible=visible and p.boxStyle=="Corners";c.BackgroundColor3=tint end
  health.Visible=p.healthBar and visible;head.Visible=p.headDot and visible;head.BackgroundColor3=tint
  for i,b in ipairs(bones) do
   local coreW,coreT,outlineW,outlineT=Stroke.resolve(p.skeletonThickness)
   local rect=boneRects[i];local w=rect[3]<=2 and coreW or rect[3];local h=rect[4]<=2 and coreW or rect[4]
   local ow=rect[3]<=2 and outlineW or rect[3]+2;local oh=rect[4]<=2 and outlineW or rect[4]+2
   b.Size=UDim2.fromOffset(w,h);b.BackgroundTransparency=coreT;outlines[i].Size=UDim2.fromOffset(ow,oh);outlines[i].BackgroundTransparency=outlineT
   b.Position=UDim2.fromOffset(rect[1]+(rect[3]<=2 and (rect[3]-w)/2 or 0),rect[2]+(rect[4]<=2 and (rect[4]-h)/2 or 0))
   outlines[i].Position=UDim2.fromOffset(rect[1]+(rect[3]<=2 and (rect[3]-ow)/2 or -1),rect[2]+(rect[4]<=2 and (rect[4]-oh)/2 or -1))
   b.Visible=p.skeleton and visible;b.BackgroundColor3=Color3.new(1,1,1);outlines[i].Visible=b.Visible
  end
  TextStyle.apply(name,Color3.new(1,1,1),Color3.new(0,0,0));TextStyle.apply(distance,Color3.new(1,1,1),Color3.new(0,0,0))
  name.Visible=p.espNames;name.TextSize=p.espTextSize;name.Text="Sample player"
  distance.Visible=p.espDistance;distance.TextSize=p.espTextSize
  center.Position=UDim2.new(0.5,-75,0,26+p.verticalOffset)
  fill.Visible=p.chams and visible;fill.BackgroundColor3=p.enemyColor=="#F0628E" and Color3.new(1,1,1) or tint;fill.BackgroundTransparency=p.chamsFill
  boxStroke.Transparency=0;fillStroke.Color=tint;fillStroke.Transparency=p.chamsOutline
  tracer.Visible=p.tracers and visible;tracer.BackgroundColor3=Color3.fromHex(p.tracerColor:sub(2))
  tracer.Position=UDim2.new(0.5,0,p.tracerOrigin=="Top" and 0 or p.tracerOrigin=="Middle" and 0.5 or 1,p.tracerOrigin=="Bottom" and -40 or 0)
  arrow.Visible=p.offscreenArrows;arrow.TextColor3=tint
  state.Text=(p.espEnabled and "ON requested" or "OFF").." · "..status
 end}
end
end
__sources["Expansion"] = function(require) -- src/Expansion.luau
local Ui=require("Ui")
local Theme=require("Theme")
local Schema=require("FeatureSchema")
local Game=require("Game")
local makeWorld=require("World")
local makePlayer=require("PlayerTools")
local makeActions=require("RuntimeActions")
local makeVisuals=require("Visuals")
local makeClickTP=require("ClickTP")
local makeDiagnostics=require("Diagnostics")
local makeAuthority=require("MovementAuthority")
local makeFlight=require("Flight")
local makeTracker=require("PlayerTracker")
local makePreview=require("VisualPreview")
local Logo=require("Logo")
return function(ctx)
 local hub=ctx.hub
 local background=require("Background")(hub,ctx.backgroundParent,ctx.prefs)
 local world=makeWorld(hub,ctx.prefs)
 local playerTools=makePlayer(hub,ctx.parent,ctx.prefs,ctx.save)
 local actions=makeActions(hub,ctx.prefs)
 local visuals=makeVisuals(hub,ctx.parent,ctx.prefs)
 local authority=makeAuthority(hub)
 local flight=makeFlight(hub,ctx.prefs,ctx.save,authority)
 ctx.safe.transport.setAuthority(authority)
 ctx.safe.beforeMove=function()
  if flight.active or ctx.prefs().flyEnabled or ctx.prefs().noclipEnabled then flight.stop("Safe Zone selected") end
 end
 flight.beforeStart=function() if ctx.safe.enabled then ctx.safe.setEnabled(false,true) end end
 local clickTP=makeClickTP(hub,ctx.parent,ctx.prefs,authority,function() return flight.active end,ctx.safe.transport)
 require("LocationControls")(ctx)
 local pages=ctx.pages
 local new={}
 for _,tab in ipairs({{"visuals","Visuals","Visible player overlays and preview"},{"player","Player","Local speed and movement panel"},{"world","World","Lighting and camera"}}) do
  new[tab[1]]=ctx.addPage(tab[1],tab[2],tab[3])
 end
 local tracker=makeTracker(hub,new.player,ctx.prefs)
 local diagnostics=makeDiagnostics(ctx,{visuals=visuals,clickTP=clickTP,player=playerTools,world=world,flight=flight,tracker=tracker})
 local refreshControls={}
 local pageRefresh={}
 local keys
 local function apply()
  if hub.closed then return end
  if keys then keys.reconcile() end
  if ctx.syncNotifications then ctx.syncNotifications() end
  Ui.setLanguage(ctx.prefs().language)
  Ui.configureMotion(ctx.prefs())
  ctx.headerRefresh()
  if ctx.statusBarRefresh then ctx.statusBarRefresh() end
  background.apply();ctx.safe.checkEmergency();world.apply();world.setBlur(ctx.prefs().backgroundBlur and ctx.isOpen());playerTools.apply();actions.applyFPS();visuals.apply();flight.apply();clickTP.apply();tracker.apply()
  for _,fn in ipairs(refreshControls) do fn(true) end
 end
 local function changed(key,value)
  ctx.prefs()[key]=value;ctx.save();apply()
  if type(value)=="boolean" and ctx.notify then local title=key;for _,d in ipairs(Schema) do if d.key==key then title=d.title;break end end;ctx.notify(Ui.localeText(title).." · "..(value and "ON" or "OFF")) end
 end
 local groups={}
 local groupCount=0
 for _,d in ipairs(Schema) do
  local page=new[d.page] or pages[d.page].page
  local group=d.page.."/"..d.section
  local card=groups[group]
  if not card then groupCount+=1;card=Ui.card(page,d.section,50+groupCount);groups[group]=card end
  local key=d.key
  local control
  if d.kind=="bool" then
   control=Ui.toggle(hub,card,d.title,d.description,ctx.prefs()[key],function(v) changed(key,v) end,1)
  elseif d.kind=="number" then
   control=Ui.slider(hub,card,d.title,{min=d.min,max=d.max,step=d.step,value=ctx.prefs()[key],order=2,description=d.description,format=function(v) if key=="skeletonThickness" then return require("SkeletonStroke").describe(v) end;if key=="chamsFill" or key=="chamsOutline" or key=="statusOpacity" or key=="clickTPOpacity" then return ("%d%%"):format(math.floor(v*100+0.5)) end;return require("SliderValue").format(v,d.step) end},function(v) changed(key,v) end)
  elseif d.kind=="choice" then
   local component=#d.options<=3 and Ui.segment or Ui.dropdown
   control=component(hub,card,d.title,d.options,ctx.prefs()[key],function(v) changed(key,v) end,2)
  elseif d.kind=="text" then
   local input=Ui.input(hub,card,d.title,{order=3},function(text) if #text<=300 and not text:find("[%c]") then changed(key,text) end end)
   control={node=input,set=function(v) input.Text=v end}
  elseif d.kind=="color" then
   local row=Ui.card(card,d.title,3,d.description)
   local grid=Ui.grid(row,35,25,1)
   local swatches={"#F0628E","#FF9BC7","#FFB340","#40C492","#42C6D2","#FFFFFF","#70AFFF"}
   local buttons={}
   for i,hex in ipairs(swatches) do
    local b=Ui.button(hub,grid,"",{order=i},function() changed(key,hex) end)
    b.BackgroundColor3=Color3.fromHex(hex:sub(2));b:SetAttribute("FixedBackground",true);b:SetAttribute("SwatchHex",hex);buttons[hex]=b
   end
   local input=Ui.input(hub,row,"#RRGGBB",{order=2},function(text) if Theme.hex(text) then changed(key,text:upper()) end end)
   Ui.register(input,d.title,d.description)
   local wheel,brightness,holder
   Ui.button(hub,row,"Pick custom color",{order=3,width=190},function()
    if holder then holder.Visible=not holder.Visible;return end
    holder=Ui.new("Frame",{BackgroundTransparency=1,AutomaticSize=Enum.AutomaticSize.Y,Size=UDim2.new(1,0,0,0),LayoutOrder=4,Parent=row});Ui.list(holder,6)
    wheel=Ui.colorWheel(hub,holder,150,1,function(c) changed(key,"#"..c:ToHex():upper()) end)
    wheel.set(Color3.fromHex(ctx.prefs()[key]:sub(2)))
    local _,_,v=wheel.get():ToHSV()
    brightness=Ui.slider(hub,holder,"Color brightness",{min=0,max=1,step=.01,value=v,order=2},function(value) wheel.setValue(value);changed(key,"#"..wheel.get():ToHex():upper()) end)
   end)
   control={node=row,set=function(v)
    if input.Text~=v then input.Text=v end
    for hex,b in pairs(buttons) do Ui.cancelAnimation(b);b.BackgroundColor3=Color3.fromHex(hex:sub(2));b.Text=hex==v and "✓" or "";b:SetAttribute("ColorSelected",hex==v) end
    if wheel then wheel.set(Color3.fromHex(v:sub(2)));local _,_,value=wheel.get():ToHSV();brightness.set(value,true) end
   end}
  else
   local row=Ui.row(card,3,32)
   Ui.text(row,d.title,{size=UDim2.new(0.55,0,1,0),textSize=Theme.size.small})
   local button
   button=Ui.button(hub,row,ctx.prefs()[key],{width=145,order=1},function()
    if not ctx.capture(function(kc)
     if kc==Enum.KeyCode.Escape then button.Text=ctx.prefs()[key];return end
     local value=kc==Enum.KeyCode.Backspace and "NONE" or kc.Name
     if value~="NONE" and ctx.keyConflict(value,key) then button.Text="Key conflict";return end
     changed(key,value);button.Text=ctx.prefs()[key]
    end) then return end
    button.Text="Press key / ⌫ clears"
   end)
   Ui.tooltip(hub,button,d.description~="" and d.description or "Esc cancels; Backspace unbinds")
   Ui.register(button,d.title,d.description)
   control={node=button,set=function(v) button.Text=v end}
  end
  if control and control.node then control.node.Name="Setting_"..key;control.node:SetAttribute("SettingKey",key) end
  if key=="fpsCap" and control.setEnabled then control.setEnabled(actions.fpsSupported) end
  if (key=="flyEnabled" or key=="noclipEnabled") and control.setEnabled then control.setEnabled(flight.available) end
  if control then
   local last=ctx.prefs()[key]
   local refresh=function(force) local value=ctx.prefs()[key];if force or value~=last then control.set(value,true);last=value end;if key=="walkSpeed" then control.node.Visible=ctx.prefs().speedMode=="Set" elseif key=="speedMultiplier" then control.node.Visible=ctx.prefs().speedMode=="Multiply" end end
   table.insert(refreshControls,refresh)
   pageRefresh[d.page]=pageRefresh[d.page] or {};table.insert(pageRefresh[d.page],refresh)
  end
 end
 for page,list in pairs(pageRefresh) do ctx.onRefresh(page,"registered control state",function() for _,fn in ipairs(list) do fn() end end) end
 -- Unsupported settings are explicit informational rows, never enabled mock controls.
 local function unsupported(page,title,description)
  local card=Ui.card(page,title,80,description)
  local button,setEnabled=Ui.button(hub,card,"Unsupported",{width=160},function() end);setEnabled(false)
  Ui.register(button,title,description)
 end
 unsupported(new.player,"CFrame Speed / Infinite Jump","No game-authorized API is established. Flight and Noclip use native local controllers or the owned Studio server when present; game acceptance is reported separately.")
 local preview=makePreview(new.visuals)
 pages.visuals.preview=preview.frame
 local function previewLayout()
  local wide=ctx.width()>=820
  if wide then
   preview.frame.Parent=ctx.content;preview.frame.Position=UDim2.new(0.64,4,0,14);preview.frame.Size=UDim2.new(0.36,-20,0,0)
   new.visuals.Size=UDim2.new(0.64,-4,1,0)
  else
   preview.frame.Parent=new.visuals;preview.frame.Position=UDim2.new();preview.frame.Size=UDim2.new(1,0,0,0)
   new.visuals.Size=UDim2.fromScale(1,1)
  end
  preview.frame.Visible=new.visuals.Visible
 end
 ctx.onRefresh("visuals","visual preview",function() previewLayout();preview.render(ctx.prefs(),visuals.status) end)
 local visualStatus=Ui.text(new.visuals,"",{order=100,textSize=Theme.size.small})
 ctx.onRefresh("visuals","visual statistics",function() Ui.set(visualStatus,"Text",visuals.status) end)
 local playerStatus=Ui.text(new.player,"",{order=100,textSize=Theme.size.small})
 ctx.onRefresh("player","player status",function() playerTools.refreshStatus();Ui.set(playerStatus,"Text",playerTools.status.."\n"..flight.status) end)
 Ui.button(hub,Ui.card(new.world,"Camera",75),"Reset Camera",{order=20,width=180},function() world.resetCamera();apply() end)
 local cameraStatus=Ui.text(new.world,"",{order=100,textSize=Theme.size.small})
 ctx.onRefresh("world","world status",function() Ui.set(cameraStatus,"Text",world.status) end)
 -- Reuse actions across Home, Utility and the Teleports section.
 local function quick(page,order)
  local card=Ui.card(page,"Session actions",order)
  local grid=Ui.grid(card,145,34,1)
  for i,action in ipairs({{"Rejoin",actions.rejoin},{"Server Hop",actions.serverHop},{"Copy Job ID",actions.copyJob}}) do Ui.button(hub,grid,action[1],{order=i},action[2]) end
  Ui.button(hub,card,"Check Reinjection",{order=2,width=190},function() local ok,reason=ctx.session.autoExecSupport();actions.status=(ok and "Reinjection prerequisites present: " or "Reinjection unavailable: ")..reason end)
  local status=Ui.text(card,"",{order=3,textSize=Theme.size.small})
  return function() Ui.set(status,"Text",actions.status) end
 end
 local homeQuick=quick(pages.dash.page,-7)
 local utilityQuick=quick(pages.utility.page,20)
 local teleQuick=quick(pages.teleports.page,20)
 ctx.onRefresh("dash","home actions",homeQuick);ctx.onRefresh("utility","utility actions",function() utilityQuick();end)
 ctx.onRefresh("teleports","teleport actions",teleQuick)
 local backgroundStatus=Ui.text(groups["settings/Background"],"",{order=20})
 ctx.onRefresh("settings","background load",function() Ui.set(backgroundStatus,"Text",background.status) end)
 local clickStatus=Ui.text(groups["teleports/Click TP"],"",{order=20,textSize=Theme.size.small})
 ctx.onRefresh("teleports","click targeting",function() Ui.set(clickStatus,"Text",clickTP.status) end)
 local fpsStatus=Ui.text(groups["utility/Rendering"],"",{order=5,textSize=Theme.size.small})
 ctx.onRefresh("utility","FPS cap status",function() Ui.set(fpsStatus,"Text",actions.fpsStatus) end)
 -- Welcome and performance use native shapes rather than borrowed art.
 local welcome=Ui.card(pages.dash.page,"Welcome · Ervi Hub",-10)
 local identity=Ui.new("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,60),Parent=welcome})
 local avatar=Ui.new("ImageLabel",{Image="",BackgroundTransparency=1,Size=UDim2.fromOffset(44,44),Position=UDim2.fromOffset(0,4),Parent=identity});Ui.corner(avatar,22)
 if type(Game.player.UserId)=="number" and Game.player.UserId>0 then avatar.Image=("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150"):format(Game.player.UserId) end
 Ui.text(identity,"Welcome back, "..(Game.player.DisplayName or Game.player.Name),{size=UDim2.new(1,-60,0,24),font=Theme.fontBold,textSize=18}).Position=UDim2.fromOffset(56,2)
 local info=Ui.text(identity,"",{size=UDim2.new(1,-60,0,30),textSize=Theme.size.small,color=Theme.muted});info.Position=UDim2.fromOffset(56,26)
 local ring=Ui.new("Frame",{BackgroundColor3=Theme.surface,Size=UDim2.new(1,0,0,54),LayoutOrder=3,Parent=welcome});Ui.corner(ring,8)
 local arcs={}
 local fps=Ui.text(ring,"0 FPS",{size=UDim2.new(0.5,-16,1,0),font=Theme.fontBold,textSize=20});fps.Position=UDim2.fromOffset(12,0)
 local latency=Ui.text(ring,"",{size=UDim2.new(0.5,-16,1,0),font=Theme.mono,textSize=14,align=Enum.TextXAlignment.Right,color=Theme.muted});latency.Position=UDim2.new(0.5,0,0,0)
 local gameInfo=Ui.card(pages.dash.page,"Game and server",-9)
 local gameIcon=Ui.new("ImageLabel",{Image="",Size=UDim2.fromOffset(56,56),BackgroundTransparency=1,LayoutOrder=0,Parent=gameInfo});Ui.corner(gameIcon,10)
 if type(game.GameId)=="number" and game.GameId>0 then gameIcon.Image=("rbxthumb://type=GameIcon&id=%d&w=150&h=150"):format(game.GameId) end
 gameIcon.Visible=type(game.GameId)=="number" and game.GameId>0
 local server=Ui.text(gameInfo,"",{order=1,textSize=Theme.size.small})
 local active=Ui.card(pages.dash.page,"Active now · click to disable",-6)
 local chipGrid=Ui.grid(active,135,28,1)
 local chips={}
 for i,entry in ipairs({{"M1 HUD","m1Enabled"},{"Anti AFK","antiAfk"},{"WalkSpeed","walkEnabled"},{"Visuals","espEnabled"},{"Movement Panel","movementPanel"},{"Auto Roll","roll"},{"Safe Zone","safe"},{"Fullbright","fullbright"},{"No Fog","noFog"},{"No Shadows","noShadows"},{"Custom Time","customTime"},{"Blur","backgroundBlur"},{"Reconnect","reconnect"},{"Auto-execute","autoExec"},{"Instant prompts","instantPrompts"},{"Target selection","targetEnabled"}}) do
  local key=entry[2]
  chips[key]=Ui.button(hub,chipGrid,entry[1],{order=i},function()
   if key=="roll" then ctx.roll:stop() elseif key=="safe" then ctx.safe.setEnabled(false) else changed(key,false);ctx.applyPrefs() end
  end)
 end
 local none=Ui.text(active,"No active optional features",{order=2,textSize=Theme.size.small,color=Theme.muted})
 local community=Ui.card(pages.dash.page,"Ervi Hub community",-8,"Only a link configured by you is used. No third-party invitation or RPC.")
 local communityText=Ui.text(community,"No community link configured",{order=1,textSize=Theme.size.small})
 Ui.button(hub,community,"Copy configured link",{order=2,width=200},function() if ctx.prefs().communityLink~="" then Game.copy(ctx.prefs().communityLink) end end)
 local link=Ui.input(hub,pages.settings.page,"Optional Ervi Hub community URL",{order=100},function(value)
  if value=="" or (value:match("^https://") and #value<=300 and not value:find("[%c]")) then ctx.prefs().communityLink=value;ctx.save();ctx.sidebarLayout() end
 end)
 link.Text=ctx.prefs().communityLink
 local started=os.clock()
 ctx.onRefresh("dash","expanded dashboard",function()
  local metrics=ctx.metrics
  Ui.set(info,"Text",("%s · Ervi Hub %s · %.0fm in this hub session"):format(game.PlaceId==119338513416973 and "RNG RollAttacks" or tostring(game.PlaceId),ctx.build.version,(os.clock()-started)/60))
  Ui.set(fps,"Text",metrics.fps.." FPS");Ui.set(latency,"Text",metrics.ping.." ms")
