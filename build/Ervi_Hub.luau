__sources["Game"] = function(require) -- src/Game.luau
-- Read-only access to client-visible game state. Every lookup is nil-safe: if the game
-- renames something, features report "missing" instead of erroring.
-- Paths/attributes come from the game's own client UI code (UIController, placeVersion 969).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Rarity = require("Rarity")

local Game = {}
local player = Players.LocalPlayer
Game.player = player
Game.KNOWN_PLACE_VERSION = 969

local attackData -- nil = not tried, false = failed, table = loaded
local attackDataError

function Game.attackData()
	if attackData == nil then
		local mod = ReplicatedStorage:FindFirstChild("AttackData")
		if mod and mod:IsA("ModuleScript") then
			-- Same cached table the game's own UI already required; it is static data.
			local ok, data = pcall(require, mod)
			if ok and type(data) == "table" and type(data.List) == "table" then
				attackData = data
			else
				attackData, attackDataError = false, ok and "unexpected format" or tostring(data)
			end
		else
			attackData, attackDataError = false, "ReplicatedStorage.AttackData not found"
		end
	end
	return attackData or nil, attackDataError
end

function Game.styles()
	local ad = Game.attackData()
	return ad and ad.List or {}
end

function Game.style(name)
	if type(name) ~= "string" then
		return nil
	end
	for _, s in ipairs(Game.styles()) do
		if s.Name == name then
			return s
		end
	end
	return nil
end

function Game.tiers()
	local ad = Game.attackData()
	return ad and type(ad.Tiers) == "table" and ad.Tiers or Rarity.FALLBACK_TIERS
end

function Game.chanceOf(name)
	local s = Game.style(name)
	return s and s.Chance
end

function Game.tierOf(name, chance)
	return Rarity.tierName(chance, Game.tiers(), Game.style(name))
end

function Game.tierColor(name, chance)
	local s = Game.style(name)
	if s and s.RarityColor then
		return s.RarityColor
	end
	for _, t in ipairs(Game.tiers()) do
		if type(chance) == "number" and chance <= t.Max then
			return t.Color
		end
	end
	return nil
end

function Game.attr(name)
	return player:GetAttribute(name)
end

function Game.serverNow()
	return workspace:GetServerTimeNow()
end

function Game.humanoid()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

function Game.alive()
	local h = Game.humanoid()
	return h ~= nil and h.Health > 0
end

function Game.equipped()
	local name = Game.attr("EquippedAttack")
	if type(name) ~= "string" or name == "" then
		return nil
	end
	return { name = name, chance = Game.chanceOf(name) }
end

function Game.rollReadyIn()
	return (Game.attr("RollReadyAt") or 0) - Game.serverNow()
end

function Game.mainUI()
	local pg = player:FindFirstChildOfClass("PlayerGui")
	return pg and pg:FindFirstChild("MainUI")
end

function Game.rollRemote()
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local r = remotes and remotes:FindFirstChild("RollAttack")
	return (r and r:IsA("RemoteFunction")) and r or nil
end

-- The game's own roll reveal is on screen (a manual roll or ForcedRoll is animating).
function Game.gameRollBusy()
	local ui = Game.mainUI()
	local reveal = ui and ui:FindFirstChild("RollRevealRoot")
	return (reveal and reveal.Visible) or Game.attr("RollConfirmOpen") == true
end

-- Same gate as the game's doRoll(): alive, in the FFA arena, cooldown <= 0.05 s.
-- Plus: never overlap with the game's own roll animation or "You will lose X" confirm.
function Game.rollStatus()
	if not Game.alive() then
		return false, "Dead - no rolling (waiting for respawn)", true
	end
	local inArena=Game.attr("InFFA")
	if type(inArena)~="boolean" then
		return false, "Arena readiness attribute unavailable (InFFA)", false
	end
	if not inArena then
		return false, "Not in the arena - jump down to roll", true
	end
	local left = Game.rollReadyIn()
	if left > 0.05 then
		return false, ("Next roll in %.1fs"):format(left), true
	end
	if Game.gameRollBusy() then
		return false, "Game roll animation or confirm dialog is open", true
	end
	return true, "Ready"
end

-- UnlockedAttacks format is not documented: try JSON, then comma list. INFERRED.
function Game.owned()
	local raw = Game.attr("UnlockedAttacks")
	if type(raw) ~= "string" or raw == "" then
		return nil
	end
	local set = {}
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
	if ok and type(decoded) == "table" then
		for k, v in pairs(decoded) do
			set[type(k) == "string" and k or tostring(v)] = true
		end
	else
		for name in raw:gmatch("[^,;|]+") do
			set[name:match("^%s*(.-)%s*$")] = true
		end
	end
	return set
end

function Game.copy(text)
	-- Executor-provided globals; plain nil when absent.
	local fn = (type(setclipboard) == "function" and setclipboard) or (type(toclipboard) == "function" and toclipboard) or nil
	if not fn then
		return false, "clipboard function not available"
	end
	local ok, err = pcall(fn, text)
	return ok, err
end

return Game
end
__sources["RollAdapter"] = function(require) -- src/RollAdapter.luau
-- Live adapter for AutoRoll. The roll request is the same zero-argument
-- RollAttack:InvokeServer() the game's own Roll button sends (UIController doRoll),
-- issued at most once per server cooldown. Nothing is forged or replayed.
local Game = require("Game")

return function()
	local adapter = {}

	adapter.now = os.clock
	adapter.wait = task.wait
	adapter.spawn = task.spawn
	adapter.canRoll = Game.rollStatus
	adapter.alive = Game.alive
	adapter.chanceOf = Game.chanceOf
	adapter.tierOf = Game.tierOf

	function adapter.readyAt()
		return Game.attr("RollReadyAt")
	end

	function adapter.currentStyle()
		return Game.equipped()
	end

	function adapter.requestRoll()
		-- Readiness can change between the worker's poll and this call. A refusal
		-- here is known not to have reached the server, unlike a missing reply.
		local ready, why, recoverable = Game.rollStatus()
		if not ready then return {done=true,notSent=true,reason=why,recoverable=recoverable} end
		local handle = { done = false }
		local remote = Game.rollRemote()
		if not remote then
			handle.done, handle.err = true, "RollAttack RemoteFunction not found (game updated?)"
			return handle
		end
		task.spawn(function()
			local ok, name, chance = pcall(remote.InvokeServer, remote)
			if ok then
				handle.name, handle.chance = name, chance
			else
				handle.err = tostring(name)
			end
			handle.done = true
		end)
		return handle
	end

	return adapter
end
end
__sources["RollObserver"] = function(require) -- src/RollObserver.luau
-- Roll Observer: passive, bounded capture of what happens during 2-3 MANUAL rolls.
-- Reads attributes and the game's own roll UI text only. Never invokes or hooks remotes.
-- Report excludes username, UserId and JobId.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Game = require("Game")
local Build = require("Build")

local MAX_EVENTS = 400
local RELEVANT = { "Roll", "Equipped", "Unlocked", "Luck", "FFA", "Confirm", "Boss", "Attack" }

local function relevant(name)
	for _, key in ipairs(RELEVANT) do
		if name:find(key, 1, true) then
			return true
		end
	end
	return false
end

local function short(v)
	local s = typeof(v) == "string" and v or tostring(v)
	if #s > 200 then
		s = s:sub(1, 200) .. ("...(%d chars)"):format(#s)
	end
	return s
end

local function capabilities()
	-- Presence check only; none of these are called except identifyexecutor.
	local probe = {
		{ "setclipboard", setclipboard },
		{ "toclipboard", toclipboard },
		{ "gethui", gethui },
		{ "identifyexecutor", identifyexecutor },
		{ "writefile", writefile },
		{ "firesignal", firesignal },
		{ "getconnections", getconnections },
		{ "hookmetamethod", hookmetamethod },
		{ "decompile", decompile },
	}
	local out = {}
	for _, p in ipairs(probe) do
		table.insert(out, ("%s=%s"):format(p[1], type(p[2]) == "function" and "yes" or "no"))
	end
	local exec = "unknown"
	if type(identifyexecutor) == "function" then
		local ok, a, b = pcall(identifyexecutor)
		if ok then
			exec = tostring(a) .. (b and (" " .. tostring(b)) or "")
		end
	end
	return exec, table.concat(out, " ")
end

return function(hubScope, log)
	local obs = { running = false, events = {}, dropped = 0, startedAt = nil, endsAt = nil, onUpdate = nil, header = "" }
	local cs

	local function push(kind, a, b)
		if #obs.events >= MAX_EVENTS then
			table.remove(obs.events, 1)
			obs.dropped += 1
		end
		table.insert(obs.events, ("+%7.3fs  %-8s %s%s"):format(os.clock() - obs.startedAt, kind, a, b and ("  " .. b) or ""))
		if obs.onUpdate then
			obs.onUpdate()
		end
	end

	local function snapshot()
		local lines = {}
		local ad, adErr = Game.attackData()
		local exec, caps = capabilities()
		table.insert(lines, ("Ervi Hub %s | Roll Observer report"):format(Build.id))
		table.insert(lines, ("PlaceId=%d PlaceVersion=%d (hub data from %d)"):format(game.PlaceId, game.PlaceVersion, Game.KNOWN_PLACE_VERSION))
		table.insert(lines, ("executor=%s"):format(exec))
		table.insert(lines, "capabilities: " .. caps)
		table.insert(lines, ("AttackData=%s styles=%d RollCooldown=%s MinRollCooldown=%s"):format(
			ad and "loaded" or ("MISSING (" .. tostring(adErr) .. ")"),
			#Game.styles(),
			tostring(ad and ad.RollCooldown),
			tostring(ad and ad.MinRollCooldown)
		))
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		local rr = remotes and remotes:FindFirstChild("RollAttack")
		table.insert(lines, ("Remotes.RollAttack=%s ForcedRoll=%s"):format(rr and rr.ClassName or "MISSING", tostring(remotes and remotes:FindFirstChild("ForcedRoll") ~= nil)))
		local ui = Game.mainUI()
		table.insert(lines, ("MainUI=%s RollRevealRoot=%s RollCooldown=%s"):format(
			tostring(ui ~= nil),
			tostring(ui and ui:FindFirstChild("RollRevealRoot") ~= nil),
			tostring(ui and ui:FindFirstChild("RollCooldown") ~= nil)
		))
		local ok, why = Game.rollStatus()
		table.insert(lines, ("rollStatus=%s (%s) serverNow=%.3f"):format(tostring(ok), why, Game.serverNow()))
		local names = {}
		for name, value in pairs(Game.player:GetAttributes()) do
			table.insert(names, name)
			if relevant(name) then
				table.insert(lines, ("  attr %s = %s"):format(name, short(value)))
			end
		end
		table.sort(names)
		table.insert(lines, ("all player attribute names (%d): %s"):format(#names, table.concat(names, ", ")))
		return table.concat(lines, "\n")
	end
	obs.snapshot = snapshot

	function obs.stop(reason)
		if not obs.running then
			return
		end
		obs.running = false
		if cs then
			cs:close()
			cs = nil
		end
		push("STOP", reason or "stopped")
		log("Diagnostics", "roll observer stopped: " .. (reason or "stopped"))
	end

	function obs.start(duration)
		obs.stop("restart")
		obs.events, obs.dropped = {}, 0
		obs.startedAt = os.clock()
		obs.endsAt = obs.startedAt + duration
		obs.header = snapshot()
		obs.running = true
		cs = hubScope:child("roll-observer")

		cs:connect(Game.player.AttributeChanged, function(name)
			if not relevant(name) then
				return
			end
			local v = Game.player:GetAttribute(name)
			local extra = nil
			if name:find("ReadyAt", 1, true) and type(v) == "number" then
				extra = ("(serverNow%+.3f)"):format(v - Game.serverNow())
			end
			push("ATTR", name .. " = " .. short(v), extra)
		end)

		local ui = Game.mainUI()
		local function watchText(inst, label, normalize)
			if not inst then
				push("MISSING", label)
				return
			end
			local last
			local function emit()
				local t = inst.Text
				local key = normalize and t:gsub("%d", "#") or t
				if key ~= last then
					last = key
					push("UI", label .. " = " .. short(t))
				end
			end
			emit()
			cs:connect(inst:GetPropertyChangedSignal("Text"), emit)
		end
		local reveal = ui and ui:FindFirstChild("RollRevealRoot")
		local panel = reveal and reveal:FindFirstChild("Panel")
		local button = ui and ui:FindFirstChild("RollButton")
		if reveal then
			push("UI", "RollRevealRoot.Visible = " .. tostring(reveal.Visible))
			cs:connect(reveal:GetPropertyChangedSignal("Visible"), function()
				push("UI", "RollRevealRoot.Visible = " .. tostring(reveal.Visible))
			end)
		else
			push("MISSING", "MainUI.RollRevealRoot")
		end
		watchText(panel and panel:FindFirstChild("Header"), "Panel.Header")
		watchText(panel and panel:FindFirstChild("Rarity"), "Panel.Rarity")
		watchText(button and button:FindFirstChild("Label"), "RollButton.Label")
		watchText(ui and ui:FindFirstChild("RollCooldown"), "RollCooldown", true) -- digits masked to skip countdown spam

		local h = Game.humanoid()
		if h then
			cs:connect(h.Died, function()
				push("CHAR", "Humanoid.Died")
			end)
		end

		local timer = task.delay(duration, function()
			obs.stop(("time limit %ds reached"):format(duration))
		end)
		cs:add(function()
			if coroutine.status(timer) ~= "dead" then
				pcall(task.cancel, timer)
			end
		end)
		push("START", ("capture %ds, max %d events"):format(duration, MAX_EVENTS))
		log("Diagnostics", "roll observer started")
	end

	function obs.report()
		local body = table.concat(obs.events, "\n")
		return ("%s\n--- events (%d kept, %d dropped) ---\n%s\n--- end ---"):format(obs.header ~= "" and obs.header or snapshot(), #obs.events, obs.dropped, body)
	end

	return obs
end
end
__sources["Session"] = function(require) -- src/Session.luau
-- Session helpers, each off by default and toggled from the Session tab:
--   Anti-AFK        When Roblox reports you idle (Player.Idled, roughly every 2 minutes while idle),
--                   send one harmless right-click through VirtualUser - the widely used method.
--                   VirtualUser needs executor permission (LocalUserSecurity).
--   Auto-reconnect  When Roblox shows a disconnect error, rejoin this place (up to 5 tries, 10 s apart).
--                   Only for connection / server errors - never after a kick, ban or security disconnect.
--                   Watches both the error event and the on-screen error prompt, because an idle drop
--                   may not raise the event (DevForum report).
--   Re-run after teleport  queue_on_teleport runs Ervi_Hub.luau from the executor workspace after
--                   teleports and rejoins while the flag file says "on". Nothing goes in autoexec.
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local TeleportService = game:GetService("TeleportService")

local HUB_FILE = "Ervi_Hub.luau"
local FLAG_FILE = "Ervi_Hub_autoexec.txt"

local RECONNECT_ON = {
	DisconnectErrors = true,
	DisconnectTimeout = true,
	DisconnectConnectionLost = true,
	DisconnectIdle = true,
	DisconnectRaknetErrors = true,
	DisconnectReceivePacketError = true,
	DisconnectReceivePacketStreamError = true,
	DisconnectSendPacketError = true,
	DisconnectEvicted = true,
	DisconnectDevMaintenance = true,
	DisconnectRobloxMaintenance = true,
	ReplicatorTimeout = true,
}

local function queueFn()
	if type(queue_on_teleport) == "function" then
		return queue_on_teleport
	elseif type(queueonteleport) == "function" then
		return queueonteleport
	end
	return nil
end

local function fileExists(name)
	if type(isfile) ~= "function" then
		return false
	end
	local ok, exists = pcall(isfile, name)
	return ok and exists == true
end

return function(hubScope, log)
	local player = Players.LocalPlayer
	local s = {
		HUB_FILE = HUB_FILE,
		QUEUED = ('if isfile and readfile and isfile("%s") and readfile("%s") == "on" and isfile("%s") then loadstring(readfile("%s"))() end'):format(
			FLAG_FILE,
			FLAG_FILE,
			HUB_FILE,
			HUB_FILE
		),
		antiAfk = false,
		reconnect = false,
		autoExec = false,
		afkPulses = 0,
		lastAfk = nil,
		reconnectStatus = "off",
		autoExecStatus = "off",
	}
	local afkScope, rcScope

	function s.setAntiAfk(on)
		if on == s.antiAfk then
			return
		end
		s.antiAfk = on
		if afkScope then
			afkScope:close()
			afkScope = nil
		end
		if not on then
			return
		end
		afkScope = hubScope:child("anti-afk")
		local ok, vu = pcall(game.GetService, game, "VirtualUser")
		if not ok or not vu then
			log("AntiAFK", "VirtualUser unavailable: " .. tostring(vu), true)
			return
		end
		afkScope:connect(player.Idled, function()
			local sent, err = pcall(function()
				vu:CaptureController()
				vu:ClickButton2(Vector2.new())
			end)
			if sent then
				s.afkPulses += 1
				s.lastAfk = os.clock()
			else
				log("AntiAFK", "could not send input: " .. tostring(err), true)
			end
		end)
	end

	function s.setReconnect(on)
		if on == s.reconnect then
			return
		end
		s.reconnect = on
		if rcScope then
			rcScope:close()
			rcScope = nil
		end
		s.reconnectStatus = on and "watching for disconnects" or "off"
		if not on then
			return
		end
		local scope = hubScope:child("reconnect")
		rcScope = scope
		local busy = false
		local function onError()
			if busy or scope.closed then
				return
			end
			local ok, code = pcall(GuiService.GetErrorCode, GuiService)
			local name = ok and code and code.Name or "unknown"
			if name == "OK" then
				return
			end
			if not RECONNECT_ON[name] then
				s.reconnectStatus = "not rejoining after " .. name
				log("Reconnect", s.reconnectStatus)
				return
			end
			busy = true
			scope:add(task.spawn(function()
				for attempt = 1, 5 do
					s.reconnectStatus = ("%s - rejoining (try %d/5)"):format(name, attempt)
					log("Reconnect", s.reconnectStatus)
					local sent, err = pcall(TeleportService.Teleport, TeleportService, game.PlaceId, player)
					if not sent then
						log("Reconnect", "teleport failed: " .. tostring(err), true)
					end
					task.wait(10)
				end
				s.reconnectStatus = "gave up after 5 tries"
				busy = false
			end))
		end
		local evOk = pcall(function()
			scope:connect(GuiService.ErrorMessageChanged, onError)
		end)
		local promptOk, overlay = pcall(function()
			return game:GetService("CoreGui").RobloxPromptGui.promptOverlay
		end)
		if promptOk and overlay then
			scope:connect(overlay.ChildAdded, function(child)
				if child.Name == "ErrorPrompt" then
					task.wait(0.5) -- let Roblox set the error code first
					onError()
				end
			end)
		end
		if not evOk and not (promptOk and overlay) then
			s.reconnectStatus = "cannot watch disconnects in this executor"
			log("Reconnect", s.reconnectStatus, true)
		end
	end

	-- ok, reason
	function s.autoExecSupport()
		if not queueFn() then
			return false, "this executor has no queue_on_teleport"
		end
		if type(writefile) ~= "function" or type(readfile) ~= "function" then
			return false, "this executor has no file access"
		end
		if not fileExists(HUB_FILE) then
			return false, HUB_FILE .. " is not in the executor workspace folder"
		end
		return true, "ready"
	end

	function s.setAutoExec(on)
		s.autoExec = on
		if type(writefile) == "function" then
			pcall(writefile, FLAG_FILE, on and "on" or "off")
		end
		if not on then
			s.autoExecStatus = "off"
			return
		end
		local ok, why = s.autoExecSupport()
		if not ok then
			s.autoExecStatus = "unavailable: " .. why
			return
		end
		local queued, err = pcall(queueFn(), s.QUEUED)
		s.autoExecStatus = queued and "on - Ervi Hub re-runs after the next teleport or rejoin" or ("queue failed: " .. tostring(err))
	end

	function s.stop()
		s.setAntiAfk(false)
		s.setReconnect(false)
	end

	return s
end
end
__sources["Prompts"] = function(require) -- src/Prompts.luau
-- Instant proximity prompts: when Roblox shows you a prompt (or you start holding one), set its
-- HoldDuration to 0 and keep it there. Turning the feature off restores every prompt it changed.
-- Event-driven via ProximityPromptService - no workspace-wide scan or DescendantAdded listener.
local ProximityPromptService = game:GetService("ProximityPromptService")

return function(hubScope, log)
	local p = { enabled = false, changed = 0 }
	local scope, originals

	local function apply(prompt)
		if not originals or originals[prompt] ~= nil or not prompt:IsA("ProximityPrompt") then
			return
		end
		originals[prompt] = prompt.HoldDuration
		prompt.HoldDuration = 0
		p.changed += 1
		scope:connect(prompt:GetPropertyChangedSignal("HoldDuration"), function()
			if prompt.HoldDuration ~= 0 then
				originals[prompt] = prompt.HoldDuration -- the game's newest intended value
				prompt.HoldDuration = 0
			end
		end)
	end

	function p.set(on)
		if on == p.enabled then
			return
		end
		p.enabled = on
		if on then
			scope = hubScope:child("instant-prompts")
			originals = setmetatable({}, { __mode = "k" })
			scope:connect(ProximityPromptService.PromptShown, apply)
			scope:connect(ProximityPromptService.PromptButtonHoldBegan, apply)
			log("Prompts", "instant prompts on")
			return
		end
		scope:close() -- stop re-zeroing first, then restore
		scope = nil
		local restored = 0
		for prompt, hold in pairs(originals) do
			if prompt.Parent and pcall(function()
				prompt.HoldDuration = hold
			end) then
				restored += 1
			end
		end
		originals = nil
		log("Prompts", ("instant prompts off, %d restored"):format(restored))
	end

	return p
end
end
__sources["App"] = function(require) -- src/App.luau
-- Ervi Hub (RNG RollAttacks) entry point.
-- Lifecycle: one hub Scope owns every GUI, connection and thread; features own child scopes.
-- The window X calls stopHub(), which nothing else can disconnect (fixes the old diagnostic X bug).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Build = require("Build")
local BootLog = require("BootLog")
local Scope = require("Scope")
local Theme = require("Theme")
local Ui = require("Ui")
local Game = require("Game")
local Rarity = require("Rarity")
local AutoRoll = require("AutoRoll")
local makeAdapter = require("RollAdapter")
local makeSafeZone = require("SafeZone")
local makeTargets = require("Targets")
local makeM1 = require("M1")
local makeObserver = require("RollObserver")
local Settings = require("Settings")
local makeSession = require("Session")
local makePrompts = require("Prompts")
local makeExpansion = require("Expansion")
local Logo=require("Logo")
local MainGeometry=require("WindowGeometry")
local makeStatusBar=require("StatusBar")

local HUB_NAME = "RNG_RollAttacks_Hub"
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Stop previous runs: this hub, baseline v1 and older diagnostics.
for _, key in ipairs({ "RNG_HUB_STOP", "RNG_CYBORG_V6_STOP", "RNG_DIAG_V5_STOP" }) do
	local stop = _G[key]
	if type(stop) == "function" then
		pcall(stop)
	end
end
-- _G is per executor context (an executor attached twice runs every script in two contexts), but
-- Instances are shared: each running hub owns a BindableFunction here that stops it. Invoke is
-- synchronous, so hubs from any context are fully stopped before this one builds its GUI.
local STOP_SIGNAL = "ErviHubStopSignal"
for _, old in ipairs(playerGui:GetChildren()) do
	if old.Name == STOP_SIGNAL and old:IsA("BindableFunction") then
		pcall(old.Invoke, old)
		if old.Parent then old:Destroy() end
	end
end
local OWNED_GUIS = { HUB_NAME, "RNG_Cyborg_M1_V6", "RNG_AttackDiagnostic_V5", "RNG_Hub_CombatHUD", "RNG_Hub_M1HUD", "Ervi_MinimizedStatus", "Ervi_MovementPanel", "Ervi_VisibleOverlays", "Ervi_Notifications" }
for _, old in ipairs(playerGui:GetChildren()) do -- every copy, not just the first match
	if table.find(OWNED_GUIS, old.Name) then
		old:Destroy()
	end
end

local hub = Scope.new("hub")
local stopped = false
local onStop = {} -- feature cleanups, registered as features are created

-- Registered before anything can yield (e.g. requiring game data), so a second Run always
-- finds and stops this one, even mid-load. A run stopped mid-load disposes whatever it adds later.
local function stopHub()
	if stopped then
		return
	end
	stopped = true
	for i = #onStop, 1, -1 do
		pcall(onStop[i])
	end
	hub:close()
	if _G.RNG_HUB_STOP == stopHub then
		_G.RNG_HUB_STOP = nil
	end
	print("[Ervi Hub] Fully stopped and cleaned.")
end
_G.RNG_HUB_STOP = stopHub
local stopSignal = hub:add(Instance.new("BindableFunction"))
stopSignal.Name = STOP_SIGNAL
stopSignal.OnInvoke = function() stopHub() return true end
stopSignal.Parent = playerGui
Ui.bindMotion(hub)

local boot=BootLog.new(Build.id,os.clock,readfile,writefile)
local function bootStep(message) if not stopped then boot.step(message) end end
bootStep("Stop handle registered; prior instance cleanup finished")

local logs = {}

local function log(feature, msg, isError)
	table.insert(logs, 1, ("%s %s: %s"):format(os.date("%H:%M:%S"), feature, msg))
	if #logs > 60 then
		table.remove(logs)
	end
	(isError and warn or print)(("[Ervi Hub] %s: %s"):format(feature, msg))
end

local function safe(feature, fn)
	return function(...)
		local ok, err = xpcall(fn, debug.traceback, ...)
		if not ok then
			log(feature, tostring(err), true)
		end
	end
end

local function isKey(name)
	if name == "Unknown" or name == "Escape" then
		return false
	end
	local ok, kc = pcall(function()
		return Enum.KeyCode[name]
	end)
	return ok and kc ~= nil
end
local function inList(list)
	return function(name)
		return Theme.find(list, name) ~= nil
	end
end
local validators = {
	toggleKey = isKey,
	safeZoneKey = function(value) return value == "NONE" or isKey(value) end,
	theme = inList(Theme.PRESETS),
	accent = function(name)
		return name == "" or Theme.hex(name) ~= nil or Theme.find(Theme.ACCENTS, name) ~= nil
	end,
	font = inList(Theme.FONTS),
	textColor = function(name)
		return Theme.hex(name) ~= nil or Theme.find(Theme.TEXT_COLORS, name) ~= nil
	end,
	bgColor = function(name)
		return name == "" or Theme.hex(name) ~= nil
	end,
}

for _,spec in ipairs(require("FeatureSchema")) do
 if spec.kind=="key" then validators[spec.key]=function(value) return value=="NONE" or isKey(value) end end
end
validators.communityLink=function(value) return value=="" or (value:match("^https://")~=nil and #value<=300) end

-- One automatically saved profile: whichever was effective (per-game/global autoload or Default).
-- Other named profiles in the file are kept untouched; the original file is backed up once.
local store = Settings.load(validators)
Settings.backupOnce()
local activeName = Settings.activeName(store, game.PlaceId)
if not store.configs[activeName] then
	Settings.put(store, activeName, Settings.defaults())
end
local prefs = store.configs[activeName]
bootStep("Settings loaded: "..activeName)
local syncBackground=function() end
local syncs = {} -- each re-reads `prefs` into its control (after loading a config, a reset or a look change)
Ui.applyLook(prefs)
Ui.setOpacity(prefs.opacity, Settings.MIN_OPACITY)
-- Every preference change calls savePrefs(); writes are coalesced (sliders and drags fire per
-- frame) and flushed on unload/teleport so the last change is never lost.
local SAVE_DELAY = 0.35
local saveState = { pending = false, ok = Settings.canPersist(), message = Settings.canPersist() and "Saved automatically" or "Session only" }
local onSaveState
local function writePrefs()
	saveState.pending = false
	local ok, err = Settings.save(store)
	if Settings.canPersist() then
		saveState.ok = ok
		saveState.message = ok and "Saved automatically" or "Save failed · see Diagnostics"
		if not ok then
			log("Settings", "could not save: " .. tostring(err), true)
		end
	end
	if onSaveState then onSaveState() end
end
local function savePrefs()
	if saveState.pending or not Settings.canPersist() then
		return
	end
	saveState.pending = true
	if onSaveState then onSaveState() end
	task.delay(SAVE_DELAY, function()
		if saveState.pending then writePrefs() end
	end)
end
local function flushPrefs()
	if saveState.pending then writePrefs() end
end
hub:add(flushPrefs)
hub:connect(player.OnTeleport, flushPrefs)

local metrics = { fps = 0, ping = 0 }
do
	local frames, since = 0, os.clock()
	hub:connect(RunService.Heartbeat, function()
		frames += 1
		local now = os.clock()
		if now - since >= 1 then
			metrics.fps = math.floor(frames / (now - since) + 0.5)
			frames, since = 0, now
			local ok, p = pcall(player.GetNetworkPing, player)
			metrics.ping = ok and math.floor(p * 1000 + 0.5) or 0
		end
	end)
end

