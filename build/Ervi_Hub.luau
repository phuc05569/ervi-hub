-- Reads replicated health at 4 Hz only while enabled. No target-processing workers.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Game=require("Game")
local Target=require("TargetState")
return function(hub,getPrefs,safeZone)
 local state=Target.new()
 local elapsed=0
 local function update()
  local prefs=getPrefs()
  local candidates={}
  if prefs.targetEnabled and Game.alive() and safeZone.saved() then
   for _,player in ipairs(Players:GetPlayers()) do
    if player~=Game.player then
     local char=player.Character
     local h=char and char:FindFirstChildOfClass("Humanoid")
     if h then table.insert(candidates,{id=player.UserId,name=player.Name,health=h.Health,maxHealth=h.MaxHealth}) end
    end
   end
  end
  state:update(prefs.targetEnabled,Game.alive(),safeZone.saved()~=nil,prefs.targetHp,candidates)
 end
 hub:connect(RunService.Heartbeat,function(dt)
  elapsed+=dt
  if elapsed>=0.25 then elapsed=0; if getPrefs().targetEnabled or state.state~="Disabled" then update() end end
 end)
 return {state=state,refresh=update}
end
end
__sources["M1State"] = function(require) -- src/M1State.luau
-- Pure read-only interpretation of a candidate server-time AttackReadyAt deadline.
-- A matching Tool is required. A style/character change invalidates prior samples.
local M1State = {}
M1State.__index = M1State

local function finite(n)
	return type(n) == "number" and n == n and math.abs(n) < math.huge
end

function M1State.new()
	return setmetatable({}, M1State)
end

function M1State:reset(style)
	self.style = style
	self.deadline = nil
	self.reason = "Waiting for a fresh AttackReadyAt sample"
end

function M1State:observe(value, now)
	self.deadline = nil
	if not self.style or not finite(value) or value <= 0 or not finite(now) then
		self.reason = "AttackReadyAt missing or invalid"
	elseif math.abs(value - now) > 120 then
		self.reason = "AttackReadyAt clock unverified (outside 120 s window)"
	else
		self.deadline = value
		self.reason = "Observed AttackReadyAt; server-time interpretation UNVERIFIED"
	end
end

function M1State:snapshot(now, equipped, alive)
	local state = { style = self.style, status = "UNKNOWN", evidence = self.reason }
	if not equipped then
		state.status, state.evidence = "UNEQUIPPED", "Equip the matching fighting-style Tool"
	elseif not alive then
		state.status, state.evidence = "UNAVAILABLE", "Waiting for a living character"
	elseif self.deadline and finite(now) then
		state.remaining = math.max(0, self.deadline - now)
		state.status = state.remaining > 0 and "COOLDOWN" or "READY"
	end
	return state
end

return M1State
end
__sources["M1"] = function(require) -- src/M1.luau
-- Candidate all-style cooldown HUD. No remotes, activation hooks or attack automation.
local Game = require("Game")
local State = require("M1State")
local Scope = require("Scope")
local Theme = require("Theme")
local Ui = require("Ui")
local makeWindow = require("FloatingWindow")
local RunService = game:GetService("RunService")

return function(hub, parent, getPrefs, save)
	local player = Game.player
	local state = State.new()
	local feature = { enabled = false }
	local character, charScope, overlayScope
	local blockedUntilSample = false
	local function styleName()
		local eq = Game.equipped()
		return eq and eq.name
	end
	local function equipped()
		local tool = character and state.style and character:FindFirstChild(state.style)
		return tool ~= nil and tool:IsA("Tool")
	end
	local function reset()
		state:reset(styleName())
		blockedUntilSample = true
	end
	local function sample()
		-- Only the player attribute is used: no guessed priority across conflicting owners.
		if equipped() and Game.alive() then
			state:observe(player:GetAttribute("AttackReadyAt"), Game.serverNow())
			blockedUntilSample = false
		end
	end
	local function bindCharacter(char)
		if charScope then charScope:close() end
		character = char
		reset()
		if hub.closed then return end
		charScope = Scope.new("m1-character")
		if not char then return end
		charScope:connect(char.ChildAdded, function(child)
			if child:IsA("Tool") then reset() end
		end)
		charScope:connect(char.ChildRemoved, function(child)
			if child:IsA("Tool") or child:IsA("Humanoid") then reset() end
		end)
		local function watchHumanoid(h)
			if h:IsA("Humanoid") then
				charScope:connect(h.Died, reset)
			end
		end
		local h = char:FindFirstChildOfClass("Humanoid")
		if h then watchHumanoid(h) end
		charScope:connect(char.ChildAdded, watchHumanoid)
	end
	bindCharacter(player.Character)
	-- Initial sample is allowed for the currently equipped Tool only.
	sample()
	hub:connect(player.CharacterAdded, bindCharacter)
	hub:connect(player.CharacterRemoving, function() bindCharacter(nil) end)
	hub:connect(player:GetAttributeChangedSignal("EquippedAttack"), reset)
	hub:connect(player:GetAttributeChangedSignal("AttackReadyAt"), sample)
	hub:add(function()
		if overlayScope then overlayScope:close() end
		if charScope then charScope:close() end
	end)

	function feature.snapshot()
		-- Death is also checked at render time in case the client omits Died.
		if not Game.alive() and not blockedUntilSample then reset() end
		return state:snapshot(Game.serverNow(), equipped(), Game.alive())
	end

	function feature.setEnabled(on)
		if hub.closed or on == feature.enabled then return end
		feature.enabled = on
		if overlayScope then overlayScope:close(); overlayScope = nil end
		feature.refreshLayout = nil
		if on then
			overlayScope = Scope.new("m1-overlay")
			local floating = makeWindow(overlayScope, parent, "RNG_Hub_M1HUD", function()
				local p = getPrefs()
				return {x=p.m1X,y=p.m1Y,w=p.m1W,h=p.m1H}
			end, function(rect)
				local p = getPrefs()
				p.m1X,p.m1Y,p.m1W,p.m1H=rect.x,rect.y,rect.w,rect.h
				save()
			end)
			feature.refreshLayout = floating.refresh
			local title = floating.title
			local big = Ui.text(floating.body, "UNKNOWN", { order = 1, textSize = Theme.size.big })
			local note = Ui.text(floating.body, "", { order = 2, textSize = Theme.size.small, color = Theme.muted })
			local elapsed = 0
			local function render()
				local s = feature.snapshot()
				Ui.set(title, "Text", (s.style or "No style") .. "  M1")
				Ui.set(big, "Text", s.status == "COOLDOWN" and ("%.2fs"):format(s.remaining) or s.status)
				Ui.set(note, "Text", s.evidence)
			end
			render()
			overlayScope:connect(RunService.Heartbeat, function(dt)
				elapsed += dt
				if elapsed >= 0.1 then elapsed = 0; render() end
			end)
		end
		if feature.onChanged then feature.onChanged(on) end
	end
	return feature
end
end
__sources["Theme"] = function(require) -- src/Theme.luau
-- Design tokens and the selectable looks. Theme is mutated in place by Theme.apply(), so code
-- that reads Theme.* at use time follows the current look; Ui.applyLook() repaints what was
-- already built by mapping each old token color to its new value (tokens are distinct per preset).
local rgb = Color3.fromRGB

local Theme = {
	font = Enum.Font.Gotham,
	fontMedium = Enum.Font.GothamMedium,
	fontBold = Enum.Font.GothamBold,
	mono = Enum.Font.Code,
	brandFont = Enum.Font.Merriweather, -- "Ervi Hub" title; never changed by the font picker

	-- neutrals + accent: replaced by the preset (initial values = Midnight)
	bg = rgb(14, 15, 20),
	surface = rgb(21, 23, 30),
	surface2 = rgb(28, 31, 40),
	raised = rgb(37, 41, 53),
	hover = rgb(46, 51, 66),
	stroke = rgb(50, 55, 70),
	text = rgb(236, 238, 244),
	muted = rgb(152, 158, 175),
	faint = rgb(100, 106, 124),
	accent = rgb(112, 140, 255),
	accentHover = rgb(134, 160, 255),

	-- fixed across looks so status always reads the same
	onAccent = rgb(255, 255, 255),
	good = rgb(78, 208, 128),
	warn = rgb(245, 186, 72),
	bad = rgb(238, 88, 88),
	info = rgb(96, 172, 255),

	size = { title = 16, h2 = 14, body = 13, small = 12, tiny = 11, big = 30 },
	radius = 10,
	radiusSm = 6,
	pad = 12,
	gap = 8,
	rowH = 30,
	windowW = 660,
	windowH = 450,
	sidebarW = 150,
	titleH = 42,
}

local NEUTRALS = { "bg", "surface", "surface2", "raised", "hover", "stroke", "text", "muted", "faint" }
Theme.TOKENS = { "bg", "surface", "surface2", "raised", "hover", "stroke", "text", "muted", "faint", "accent", "accentHover" }

Theme.PRESETS = {
	{ name = "Midnight", accent = "Indigo", bg = rgb(14, 15, 20), surface = rgb(21, 23, 30), surface2 = rgb(28, 31, 40), raised = rgb(37, 41, 53), hover = rgb(46, 51, 66), stroke = rgb(50, 55, 70), text = rgb(236, 238, 244), muted = rgb(152, 158, 175), faint = rgb(100, 106, 124) },
	{ name = "Graphite", accent = "Cyan", bg = rgb(18, 18, 19), surface = rgb(26, 26, 28), surface2 = rgb(34, 34, 37), raised = rgb(45, 45, 49), hover = rgb(56, 56, 61), stroke = rgb(61, 61, 66), text = rgb(241, 241, 242), muted = rgb(161, 161, 167), faint = rgb(111, 111, 118) },
	{ name = "Ocean", accent = "Sky", bg = rgb(9, 17, 28), surface = rgb(13, 25, 40), surface2 = rgb(18, 33, 52), raised = rgb(26, 45, 68), hover = rgb(34, 57, 84), stroke = rgb(38, 62, 90), text = rgb(230, 242, 255), muted = rgb(140, 165, 190), faint = rgb(92, 116, 142) },
	{ name = "Crimson", accent = "Rose", bg = rgb(20, 10, 12), surface = rgb(29, 15, 18), surface2 = rgb(38, 20, 24), raised = rgb(52, 28, 33), hover = rgb(64, 35, 41), stroke = rgb(72, 40, 46), text = rgb(250, 236, 238), muted = rgb(185, 150, 156), faint = rgb(132, 100, 106) },
	{ name = "Forest", accent = "Mint", bg = rgb(11, 17, 13), surface = rgb(16, 25, 19), surface2 = rgb(22, 33, 26), raised = rgb(31, 45, 35), hover = rgb(40, 57, 45), stroke = rgb(44, 62, 49), text = rgb(234, 246, 236), muted = rgb(150, 175, 156), faint = rgb(100, 124, 106) },
	{ name = "Light", accent = "Indigo", bg = rgb(232, 235, 241), surface = rgb(244, 246, 250), surface2 = rgb(252, 252, 254), raised = rgb(222, 226, 234), hover = rgb(208, 213, 224), stroke = rgb(196, 202, 214), text = rgb(24, 26, 32), muted = rgb(86, 92, 108), faint = rgb(128, 134, 148) },
}

Theme.ACCENTS = {
	{ name = "Indigo", color = rgb(112, 140, 255) },
	{ name = "Violet", color = rgb(166, 112, 255) },
	{ name = "Rose", color = rgb(240, 98, 142) },
	{ name = "Sky", color = rgb(62, 168, 240) },
	{ name = "Cyan", color = rgb(42, 198, 210) },
	{ name = "Mint", color = rgb(64, 196, 146) },
	{ name = "Amber", color = rgb(236, 164, 46) },
}

-- Only fonts present in Enum.Font (checked against the Roblox API dump).
Theme.FONTS = {
	{ name = "Gotham", regular = Enum.Font.Gotham, medium = Enum.Font.GothamMedium, bold = Enum.Font.GothamBold },
	{ name = "Source Sans", regular = Enum.Font.SourceSans, medium = Enum.Font.SourceSansSemibold, bold = Enum.Font.SourceSansBold },
	{ name = "Arial", regular = Enum.Font.Arial, medium = Enum.Font.Arial, bold = Enum.Font.ArialBold },
	{ name = "Roboto", regular = Enum.Font.Roboto, medium = Enum.Font.Roboto, bold = Enum.Font.RobotoCondensed },
	{ name = "Ubuntu", regular = Enum.Font.Ubuntu, medium = Enum.Font.Ubuntu, bold = Enum.Font.Ubuntu },
	{ name = "Nunito", regular = Enum.Font.Nunito, medium = Enum.Font.Nunito, bold = Enum.Font.Nunito },
	{ name = "Fredoka", regular = Enum.Font.FredokaOne, medium = Enum.Font.FredokaOne, bold = Enum.Font.FredokaOne },
	{ name = "Arcade", regular = Enum.Font.Arcade, medium = Enum.Font.Arcade, bold = Enum.Font.Arcade },
}

-- "Theme" keeps the preset's own text color. Values avoid the fixed status colors.
Theme.TEXT_COLORS = {
	{ name = "Theme" },
	{ name = "White", color = rgb(250, 250, 250) },
	{ name = "Gold", color = rgb(255, 214, 120) },
	{ name = "Cyan", color = rgb(150, 230, 255) },
	{ name = "Pink", color = rgb(255, 170, 210) },
	{ name = "Mint", color = rgb(170, 250, 205) },
}

function Theme.find(list, name)
	for _, item in ipairs(list) do
		if item.name == name then
			return item
		end
	end
	return nil
end

-- "#RRGGBB" -> Color3, anything else -> nil.
function Theme.hex(s)
	if type(s) == "string" and s:match("^#%x%x%x%x%x%x$") then
		return Color3.fromHex(s)
	end
	return nil
end

local WHITE = Color3.new(1, 1, 1)
local LIGHT = Theme.PRESETS[6]

-- look: { theme, accent ("" | name | "#hex"), font, textColor (name | "#hex"), bgColor ("" | "#hex") }.
-- Mutates Theme and returns { [oldHex] = newColor } for repainting existing UI.
function Theme.apply(look)
	local preset = Theme.find(Theme.PRESETS, look.theme) or Theme.PRESETS[1]
	local font = Theme.find(Theme.FONTS, look.font) or Theme.FONTS[1]

	local new = {}
	for _, k in ipairs(NEUTRALS) do
		new[k] = preset[k]
	end
	-- Custom background: panels are progressively lighter shades of it; light backgrounds get dark text.
	local bg = Theme.hex(look.bgColor)
	if bg then
		new.bg = bg
		new.surface = bg:Lerp(WHITE, 0.04)
		new.surface2 = bg:Lerp(WHITE, 0.08)
		new.raised = bg:Lerp(WHITE, 0.15)
		new.hover = bg:Lerp(WHITE, 0.22)
		new.stroke = bg:Lerp(WHITE, 0.27)
		local _, _, value = bg:ToHSV()
		local textSource = value > 0.7 and LIGHT or Theme.PRESETS[1]
		new.text, new.muted, new.faint = textSource.text, textSource.muted, textSource.faint
	end
	local textColor = Theme.find(Theme.TEXT_COLORS, look.textColor)
	new.text = Theme.hex(look.textColor) or (textColor and textColor.color) or new.text
	local accent = Theme.find(Theme.ACCENTS, look.accent ~= "" and look.accent or preset.accent) or Theme.ACCENTS[1]
	new.accent = Theme.hex(look.accent) or accent.color
	new.accentHover = new.accent:Lerp(WHITE, 0.18)

	-- Repainting maps colors by value, so every token must be unique and differ from the fixed
	-- status colors. A clash is nudged by one RGB step (invisible).
	local used = {}
	for _, k in ipairs({ "onAccent", "good", "warn", "bad", "info" }) do
		used[Theme[k]:ToHex()] = true
	end
	for _, k in ipairs(Theme.TOKENS) do
		local c = new[k]
		local step = 0
		while used[c:ToHex()] do
			step += 1
			local r = math.floor(c.R * 255 + 0.5)
			c = Color3.fromRGB(r >= 128 and r - step or r + step, math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
		end
		used[c:ToHex()] = true
		new[k] = c
	end

	local map = {}
	for _, k in ipairs(Theme.TOKENS) do
		map[Theme[k]:ToHex()] = new[k]
		Theme[k] = new[k]
	end
	Theme.font, Theme.fontMedium, Theme.fontBold = font.regular, font.medium, font.bold
	return map
end

return Theme
end
__sources["Ui"] = function(require) -- src/Ui.luau
-- Small component kit on raw Roblox instances (no third-party UI library, no loadstring).
local UserInputService = game:GetService("UserInputService")
local Theme = require("Theme")

local Ui = {}

-- Appearance state shared by every component (also ones built later):
--   opacity   -> BackgroundTransparency of registered surfaces (window, panels, cards, overlay)
--   textScale / textAlpha / outline -> every text object (outline "auto" = only below 60% opacity)
Ui.opacity = 1
Ui.textScale = 1
Ui.textAlpha = 0
Ui.outline = "auto"
local LOW_OPACITY = 0.6
local TEXT_STROKE = 0.55
local TEXT_CLASSES = { TextLabel = true, TextButton = true, TextBox = true }
local FONT_ROLES = { "fontBold", "fontMedium", "font", "mono" }
local surfaces = setmetatable({}, { __mode = "k" })
local roots = setmetatable({}, { __mode = "k" })

local function outlineOn()
	return Ui.outline == "on" or (Ui.outline == "auto" and Ui.opacity < LOW_OPACITY)
end

-- Size from the unscaled base (kept as an attribute), plus transparency and outline.
local function styleText(inst)
	local base = inst:GetAttribute("BaseTextSize")
	if not base then
		base = inst.TextSize
		inst:SetAttribute("BaseTextSize", base)
	end
	inst.TextSize = math.floor(base * Ui.textScale + 0.5)
	inst.TextTransparency = inst:GetAttribute("Disabled") and math.max(0.5, Ui.textAlpha) or Ui.textAlpha
	inst.TextStrokeTransparency = outlineOn() and TEXT_STROKE or 1
end

function Ui.new(class, props, children)
	local inst = Instance.new(class)
	local parent = props and props.Parent
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	if TEXT_CLASSES[class] then
		for _, role in ipairs(FONT_ROLES) do
			if props and props.Font == Theme[role] then
				inst:SetAttribute("FontRole", role) -- lets a font change re-map this text later
				break
			end
		end
		styleText(inst)
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

-- Registers a ScreenGui whose contents follow look changes.
function Ui.root(gui)
	roots[gui] = true
	return gui
end

-- Registers a background surface so it follows the menu opacity.
function Ui.surface(inst)
	surfaces[inst] = true
	inst.BackgroundTransparency = 1 - Ui.opacity
	return inst
end

local function eachText(fn)
	for root in pairs(roots) do
		if root.Parent then
			for _, d in ipairs(root:GetDescendants()) do
				if TEXT_CLASSES[d.ClassName] then
					fn(d)
				end
			end
		end
	end
end

function Ui.setOpacity(o, minimum)
	o = math.clamp(o, minimum or 0, 1)
	local outlineBefore = outlineOn()
	Ui.opacity = o
	for inst in pairs(surfaces) do
		if inst.Parent then
			inst.BackgroundTransparency = 1 - o
		end
	end
	if outlineOn() ~= outlineBefore then
		eachText(styleText) -- only when "auto" outline flips, so dragging the slider stays cheap
	end
	return o
end

-- Applies a full look (design, accent, font, text color/size/transparency/outline) and repaints
-- everything already built. FixedBackground / FixedTextColor elements (color previews) keep theirs.
function Ui.applyLook(look)
	local map = Theme.apply(look)
	Ui.textScale, Ui.textAlpha, Ui.outline = look.textScale, look.textAlpha, look.outline
	local function remap(inst, prop)
		local c = inst[prop]
		local new = c and map[c:ToHex()]
		if new then
			inst[prop] = new
		end
	end
	for root in pairs(roots) do
		if root.Parent then
			for _, d in ipairs(root:GetDescendants()) do
				local isText = TEXT_CLASSES[d.ClassName]
				if d:IsA("GuiObject") and not d:GetAttribute("FixedBackground") then
					remap(d, "BackgroundColor3")
				end
				if d:IsA("UIStroke") then
					if not d:GetAttribute("FixedBackground") then
						remap(d, "Color")
					end
				elseif d:IsA("ScrollingFrame") then
					remap(d, "ScrollBarImageColor3")
				end
				if isText and not d:GetAttribute("FixedTextColor") then
					remap(d, "TextColor3")
					if d:IsA("TextBox") then
						remap(d, "PlaceholderColor3")
					end
				end
				if isText then
					local role = d:GetAttribute("FontRole")
					if role then
						d.Font = Theme[role]
					end
					styleText(d)
				end
			end
		end
	end
end

-- Assign only when changed: avoids needless property writes from the 10 Hz refresh loop.
function Ui.set(inst, prop, value)
	if inst[prop] ~= value then
		inst[prop] = value
	end
end

function Ui.corner(parent, r)
	return Ui.new("UICorner", { CornerRadius = UDim.new(0, r or Theme.radiusSm), Parent = parent })
end

function Ui.stroke(parent, color, transparency)
	return Ui.new("UIStroke", {
		Color = color or Theme.stroke,
		Transparency = transparency or 0,
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function Ui.pad(parent, t, r, b, l)
	return Ui.new("UIPadding", {
		PaddingTop = UDim.new(0, t),
		PaddingRight = UDim.new(0, r or t),
		PaddingBottom = UDim.new(0, b or t),
		PaddingLeft = UDim.new(0, l or r or t),
		Parent = parent,
	})
end

function Ui.list(parent, gap, horizontal, valign)
	return Ui.new("UIListLayout", {
		Padding = UDim.new(0, gap or Theme.gap),
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

-- Auto-height wrapped text.
function Ui.text(parent, text, opts)
	opts = opts or {}
	return Ui.new("TextLabel", {
		BackgroundTransparency = 1,
		Size = opts.size or UDim2.new(1, 0, 0, 0),
		AutomaticSize = opts.size and Enum.AutomaticSize.None or Enum.AutomaticSize.Y,
		Text = text,
		RichText = opts.rich or false,
		TextWrapped = true,
		TextColor3 = opts.color or Theme.text,
		TextSize = opts.textSize or Theme.size.body,
		Font = opts.font or Theme.font,
		TextXAlignment = opts.align or Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		LayoutOrder = opts.order or 0,
		Parent = parent,
	})
end

-- Theme token names (looked up at use time so looks can change) or fixed colors.
local VARIANTS = {
	primary = { bg = "accent", hover = "accentHover", fg = "onAccent" },
	secondary = { bg = "raised", hover = "hover", fg = "text" },
	danger = { bg = Color3.fromRGB(120, 38, 42), hover = Color3.fromRGB(150, 48, 52), fg = "text" },
	ghost = { bg = "surface2", hover = "raised", fg = "muted" },
}
local function color(c)
	return type(c) == "string" and Theme[c] or c
end

-- Returns the button plus setEnabled(bool). Disabled buttons ignore clicks and look dimmed.
function Ui.button(scope, parent, text, opts, onClick)
	opts = opts or {}
	local v = VARIANTS[opts.variant or "secondary"]
	local enabled = true
	local btn = Ui.new("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = color(v.bg),
		Size = opts.size or UDim2.new(0, opts.width or 110, 0, opts.height or Theme.rowH),
		Text = text,
		TextColor3 = color(v.fg),
		TextSize = opts.textSize or Theme.size.body,
		Font = Theme.fontMedium,
		LayoutOrder = opts.order or 0,
		Parent = parent,
	})
	Ui.corner(btn)
	scope:connect(btn.MouseEnter, function()
		if enabled and not btn:GetAttribute("FixedBackground") then
			btn.BackgroundColor3 = btn:GetAttribute("Selected") and Theme.accentHover or color(v.hover)
		end
	end)
	scope:connect(btn.MouseLeave, function()
		if btn:GetAttribute("FixedBackground") then
			return
		end
		btn.BackgroundColor3 = btn:GetAttribute("Selected") and Theme.accent or color(v.bg)
	end)
	if onClick then
		scope:connect(btn.Activated, function()
			if enabled then
				onClick()
			end
		end)
	end
	local function setEnabled(on)
		enabled = on
		btn:SetAttribute("Disabled", not on or nil)
		btn.BackgroundTransparency = on and 0 or 0.55
		btn.TextTransparency = on and Ui.textAlpha or math.max(0.5, Ui.textAlpha)
	end
	return btn, setEnabled
end

-- Wrapping grid of equal cells (for option pickers).
function Ui.grid(parent, cellW, cellH, order)
	local f = Ui.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order or 0,
		Parent = parent,
	})
	Ui.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(cellW, cellH),
		CellPadding = UDim2.fromOffset(6, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = f,
	})
	return f
end

-- Marks a secondary button as the selected option of a group (survives hover).
function Ui.select(btn, on)
	btn:SetAttribute("Selected", on or nil)
	btn.BackgroundColor3 = on and Theme.accent or Theme.raised
end

-- Card: titled surface whose height follows its content.
function Ui.card(parent, title, order, subtitle)
	local card = Ui.new("Frame", {
		BackgroundColor3 = Theme.surface2,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order or 0,
		Parent = parent,
	})
	Ui.surface(card)
	Ui.corner(card, Theme.radius)
	Ui.stroke(card, Theme.stroke, 0.35)
	Ui.pad(card, Theme.pad)
	Ui.list(card, Theme.gap)
	if title then
		Ui.text(card, title:upper(), { font = Theme.fontBold, textSize = Theme.size.tiny, color = Theme.muted, order = -2 })
	end
	if subtitle then
		Ui.text(card, subtitle, { textSize = Theme.size.small, color = Theme.faint, order = -1 })
	end
	return card
end

-- Horizontal row container (fixed height) for button groups.
function Ui.row(parent, order, height)
	local row = Ui.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height or Theme.rowH),
		LayoutOrder = order or 0,
		Parent = parent,
	})
	Ui.list(row, 6, true, Enum.VerticalAlignment.Center)
	return row
end

-- Key/value line. Returns setter(text, color?).
function Ui.kv(parent, key, order)
	local row = Ui.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = order or 0, Parent = parent })
	Ui.text(row, key, { size = UDim2.new(0.42, 0, 1, 0), color = Theme.muted, textSize = Theme.size.small })
	local value = Ui.text(row, "-", { size = UDim2.new(0.58, 0, 1, 0), align = Enum.TextXAlignment.Right, font = Theme.fontMedium, textSize = Theme.size.small })
	value.Position = UDim2.fromScale(0.42, 0)
	value.TextTruncate = Enum.TextTruncate.AtEnd
	value.TextWrapped = false
	return function(text, color)
		Ui.set(value, "Text", text)
		Ui.set(value, "TextColor3", color or Theme.text)
	end
end

local PILL = { good = "good", warn = "warn", bad = "bad", info = "info", idle = "muted" }

-- Status pill. Returns setter(text, kind) where kind is good|warn|bad|info|idle.
function Ui.pill(parent, order)
	local pill = Ui.new("TextLabel", {
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 0, 22),
		BackgroundColor3 = Theme.raised,
		Text = "",
		TextSize = Theme.size.tiny,
		Font = Theme.fontBold,
		TextColor3 = Theme.muted,
		LayoutOrder = order or 0,
		Parent = parent,
	})
	Ui.corner(pill, 11)
	Ui.pad(pill, 0, 10)
	return function(text, kind)
		Ui.set(pill, "Text", text:upper())
		Ui.set(pill, "TextColor3", Theme[PILL[kind or "idle"] or "muted"])
	end
end

-- Progress bar. Returns setter(fraction 0..1, color?).
function Ui.bar(parent, order, height)
	local track = Ui.new("Frame", {
		BackgroundColor3 = Theme.raised,
		Size = UDim2.new(1, 0, 0, height or 8),
		LayoutOrder = order or 0,
		Parent = parent,
	})
	Ui.corner(track, 4)
	local fill = Ui.new("Frame", { BackgroundColor3 = Theme.accent, Size = UDim2.fromScale(0, 1), Parent = track })
	Ui.corner(fill, 4)
	return function(frac, color)
		frac = math.clamp(frac, 0, 1)
		Ui.set(fill, "Size", UDim2.fromScale(frac, 1))
		Ui.set(fill, "Visible", frac > 0)
		if color then
			Ui.set(fill, "BackgroundColor3", color)
		end
	end
end

-- iOS-style switch with label and description. Returns { set(bool, silent), get() }.
function Ui.toggle(scope, parent, label, desc, initial, onChange, order)
	local row = Ui.new("TextButton", {
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order or 0,
		Parent = parent,
	})
	local textCol = Ui.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -56, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = row })
	Ui.list(textCol, 2)
	Ui.text(textCol, label, { font = Theme.fontMedium })
	if desc then
		Ui.text(textCol, desc, { textSize = Theme.size.small, color = Theme.faint, order = 1 })
	end
	local track = Ui.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 2),
		Size = UDim2.fromOffset(42, 22),
		BackgroundColor3 = Theme.raised,
		Parent = row,
	})
	Ui.corner(track, 11)
	local knob = Ui.new("Frame", { Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = Theme.muted, Parent = track })
	Ui.corner(knob, 8)
	local value = false
	local api = {}
	function api.set(on, silent)
		value = on == true
		track.BackgroundColor3 = value and Theme.accent or Theme.raised
		knob.BackgroundColor3 = value and Theme.onAccent or Theme.muted
		knob.Position = UDim2.fromOffset(value and 23 or 3, 3)
		if not silent and onChange then
			onChange(value)
		end
	end
	function api.get()
		return value
	end
	api.set(initial, true)
	scope:connect(row.Activated, function()
		api.set(not value)
	end)
	return api
end

function Ui.input(scope, parent, placeholder, opts, onCommit)
	opts = opts or {}
	local box = Ui.new("TextBox", {
		BackgroundColor3 = Theme.surface,
		Size = opts.size or UDim2.new(0, opts.width or 160, 0, Theme.rowH),
		ClearTextOnFocus = false,
		PlaceholderText = placeholder,
		PlaceholderColor3 = Theme.faint,
		Text = opts.text or "",
		TextColor3 = Theme.text,
		TextSize = opts.textSize or Theme.size.body,
		Font = opts.font or Theme.font,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = opts.multiline or false,
		MultiLine = opts.multiline or false,
		TextYAlignment = opts.multiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
		LayoutOrder = opts.order or 0,
		Parent = parent,
	})
	Ui.corner(box)
	local stroke = Ui.stroke(box, Theme.stroke)
	Ui.pad(box, opts.multiline and 8 or 0, 10)
	scope:connect(box.Focused, function()
		stroke.Color = Theme.accent
	end)
	scope:connect(box.FocusLost, function(enter)
		stroke.Color = Theme.stroke
		if onCommit then
			onCommit(box.Text, enter)
		end
	end)
	return box
end

-- Drag `target` by `handle` (mouse or touch). Replaces the deprecated Frame.Draggable.
function Ui.drag(scope, handle, target)
	local dragging, startInput, startPos
	scope:connect(handle.InputBegan, function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			dragging, startInput, startPos = true, input.Position, target.Position
		end
	end)
	scope:connect(UserInputService.InputEnded, function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	scope:connect(UserInputService.InputChanged, function(input)
		if not dragging then
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch then
			local d = input.Position - startInput
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
end

-- Vertical scrolling page that grows with content.
function Ui.scroll(parent, props)
	local sf = Ui.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Theme.stroke,
		Parent = parent,
	})
	for k, v in pairs(props or {}) do
		sf[k] = v
	end
	return sf
end

-- Color circle: hue = angle, saturation = distance from the centre (brightness comes from a
-- separate slider via setValue). Built from rotated gradient bars clipped to a circle - no assets.
-- Returns { set(color), setValue(v), get() -> Color3, wheel }. onPick(color) fires while picking.
function Ui.colorWheel(scope, parent, size, order, onPick)
	local holder = Ui.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, size), LayoutOrder = order or 0, Parent = parent })
	local wheel = Ui.new("CanvasGroup", { Size = UDim2.fromOffset(size, size), BackgroundColor3 = Color3.new(1, 1, 1), Active = true, Parent = holder })
	wheel:SetAttribute("FixedBackground", true)
	Ui.new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = wheel })
	for i = 0, 89 do
		local angle = i * 2
		local bar = Ui.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, 0, 0, 5),
			Rotation = angle,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Parent = wheel,
		})
		bar:SetAttribute("FixedBackground", true)
		Ui.new("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromHSV(((angle + 180) % 360) / 360, 1, 1)),
				ColorSequenceKeypoint.new(0.5, Color3.new(1, 1, 1)),
				ColorSequenceKeypoint.new(1, Color3.fromHSV(angle / 360, 1, 1)),
			}),
			Parent = bar,
		})
	end
	local shade = Ui.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Parent = wheel })
	shade:SetAttribute("FixedBackground", true)
	local marker = Ui.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1, Parent = holder })
	Ui.new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = marker })
	local ring = Ui.new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, Parent = marker })
	ring:SetAttribute("FixedBackground", true)

	local h, s, v = 0, 0, 1
	local api = { wheel = wheel }
	local function render()
		local a = h * 2 * math.pi
		marker.Position = UDim2.fromOffset(size / 2 + math.cos(a) * s * size / 2, size / 2 + math.sin(a) * s * size / 2)
		shade.BackgroundTransparency = v
	end
	function api.get()
		return Color3.fromHSV(h, s, v)
	end
	function api.set(c)
		h, s, v = c:ToHSV()
		render()
	end
	function api.setValue(value)
		v = value
		render()
	end
	local function pick(x, y)
		local pos, sz = wheel.AbsolutePosition, wheel.AbsoluteSize
		local r = sz.X / 2
		if r <= 0 then
			return
		end
		local dx, dy = x - (pos.X + r), y - (pos.Y + r)
		h = (math.deg(math.atan2(dy, dx)) % 360) / 360
		s = math.min(math.sqrt(dx * dx + dy * dy) / r, 1)
		render()
		if onPick then
			onPick(api.get())
		end
	end
	local dragging = false
	scope:connect(wheel.InputBegan, function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			dragging = true
			pick(input.Position.X, input.Position.Y)
		end
	end)
	scope:connect(UserInputService.InputChanged, function(input)
		local t = input.UserInputType
		if dragging and (t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch) then
			pick(input.Position.X, input.Position.Y)
		end
	end)
	scope:connect(UserInputService.InputEnded, function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	render()
	return api
end

-- Horizontal slider with − / + step buttons (usable without dragging). Returns { set(v, silent), get() }.
-- opts: min, max, step, value, format(v) -> string, order
function Ui.slider(scope, parent, label, opts, onChange)
	local lo, hi, step = opts.min, opts.max, opts.step
	local row = Ui.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = opts.order or 0, Parent = parent })
	Ui.text(row, label, { size = UDim2.new(1, -70, 0, 18), font = Theme.fontMedium })
	local valueText = Ui.text(row, "", { size = UDim2.new(0, 70, 0, 18), align = Enum.TextXAlignment.Right, font = Theme.mono, textSize = Theme.size.small })
	valueText.Position = UDim2.new(1, -70, 0, 0)
	local function stepButton(text, pos)
		local b = Ui.new("TextButton", {
			AutoButtonColor = true,
			BackgroundColor3 = Theme.raised,
			Position = pos,
			Size = UDim2.fromOffset(26, 22),
			Text = text,
			TextColor3 = Theme.text,
			TextSize = 16,
			Font = Theme.fontBold,
			Parent = row,
		})
		Ui.corner(b)
		return b
	end
	local minus = stepButton("−", UDim2.fromOffset(0, 24))
	local plus = stepButton("+", UDim2.new(1, -26, 0, 24))
	local track = Ui.new("Frame", { BackgroundColor3 = Theme.raised, Position = UDim2.new(0, 36, 0, 32), Size = UDim2.new(1, -72, 0, 6), Active = true, Parent = row })
	Ui.corner(track, 3)
	local fill = Ui.new("Frame", { BackgroundColor3 = Theme.accent, Size = UDim2.fromScale(0, 1), Parent = track })
	Ui.corner(fill, 3)
	local knob = Ui.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Theme.text, Parent = track })
	Ui.corner(knob, 7)

	local value
	local api = {}
	function api.set(v, silent)
		v = math.clamp(lo + math.floor((v - lo) / step + 0.5) * step, lo, hi)
		if v == value then
			return
		end
		value = v
		local frac = (v - lo) / (hi - lo)
		fill.Size = UDim2.fromScale(frac, 1)
		knob.Position = UDim2.fromScale(frac, 0.5)
		valueText.Text = opts.format and opts.format(v) or tostring(v)
		if not silent and onChange then
			onChange(v)
		end
	end
	function api.get()
		return value
	end
	local function fromX(x)
		local width = track.AbsoluteSize.X
		if width > 0 then
			api.set(lo + (x - track.AbsolutePosition.X) / width * (hi - lo))
		end
	end
	local dragging = false
	scope:connect(track.InputBegan, function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			dragging = true
			fromX(input.Position.X)
		end
	end)
	scope:connect(UserInputService.InputChanged, function(input)
		local t = input.UserInputType
		if dragging and (t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch) then
			fromX(input.Position.X)
		end
	end)
	scope:connect(UserInputService.InputEnded, function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	scope:connect(minus.Activated, function()
		api.set(value - step)
	end)
	scope:connect(plus.Activated, function()
		api.set(value + step)
	end)
	api.set(opts.value, true)
	return api
end

return Ui
end
__sources["Game"] = function(require) -- src/Game.luau
-- Read-only access to client-visible game state. Every lookup is nil-safe: if the game
-- renames something, features report "missing" instead of erroring.
-- Paths/attributes come from the game's own client UI code (UIController, placeVersion 969).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Rarity = require("Rarity")

local Game = {}
local player = Players.LocalPlayer
Game.player = player
Game.KNOWN_PLACE_VERSION = 969

local attackData -- nil = not tried, false = failed, table = loaded
local attackDataError

function Game.attackData()
	if attackData == nil then
		local mod = ReplicatedStorage:FindFirstChild("AttackData")
		if mod and mod:IsA("ModuleScript") then
			-- Same cached table the game's own UI already required; it is static data.
			local ok, data = pcall(require, mod)
			if ok and type(data) == "table" and type(data.List) == "table" then
				attackData = data
			else
				attackData, attackDataError = false, ok and "unexpected format" or tostring(data)
			end
		else
			attackData, attackDataError = false, "ReplicatedStorage.AttackData not found"
		end
	end
	return attackData or nil, attackDataError
end

function Game.styles()
	local ad = Game.attackData()
	return ad and ad.List or {}
end

function Game.style(name)
	if type(name) ~= "string" then
		return nil
	end
	for _, s in ipairs(Game.styles()) do
		if s.Name == name then
			return s
		end
	end
	return nil
end

function Game.tiers()
	local ad = Game.attackData()
	return ad and type(ad.Tiers) == "table" and ad.Tiers or Rarity.FALLBACK_TIERS
end

function Game.chanceOf(name)
	local s = Game.style(name)
	return s and s.Chance
end

function Game.tierOf(name, chance)
	return Rarity.tierName(chance, Game.tiers(), Game.style(name))
end

function Game.tierColor(name, chance)
	local s = Game.style(name)
	if s and s.RarityColor then
		return s.RarityColor
	end
	for _, t in ipairs(Game.tiers()) do
		if type(chance) == "number" and chance <= t.Max then
			return t.Color
		end
	end
	return nil
end

function Game.attr(name)
	return player:GetAttribute(name)
end

function Game.serverNow()
	return workspace:GetServerTimeNow()
end

function Game.humanoid()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

function Game.alive()
	local h = Game.humanoid()
	return h ~= nil and h.Health > 0
end

function Game.equipped()
	local name = Game.attr("EquippedAttack")
	if type(name) ~= "string" or name == "" then
		return nil
	end
	return { name = name, chance = Game.chanceOf(name) }
end

function Game.rollReadyIn()
	return (Game.attr("RollReadyAt") or 0) - Game.serverNow()
end

function Game.mainUI()
	local pg = player:FindFirstChildOfClass("PlayerGui")
	return pg and pg:FindFirstChild("MainUI")
end

function Game.rollRemote()
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local r = remotes and remotes:FindFirstChild("RollAttack")
	return (r and r:IsA("RemoteFunction")) and r or nil
end

-- The game's own roll reveal is on screen (a manual roll or ForcedRoll is animating).
function Game.gameRollBusy()
	local ui = Game.mainUI()
	local reveal = ui and ui:FindFirstChild("RollRevealRoot")
	return (reveal and reveal.Visible) or Game.attr("RollConfirmOpen") == true
end

-- Same gate as the game's doRoll(): alive, in the FFA arena, cooldown <= 0.05 s.
-- Plus: never overlap with the game's own roll animation or "You will lose X" confirm.
function Game.rollStatus()
	if not Game.alive() then
		return false, "Dead - no rolling (waiting for respawn)"
	end
	if not Game.attr("InFFA") then
		return false, "Not in the arena - jump down to roll"
	end
	local left = Game.rollReadyIn()
	if left > 0.05 then
		return false, ("Next roll in %.1fs"):format(left)
	end
	if Game.gameRollBusy() then
		return false, "Game roll animation or confirm dialog is open"
	end
	return true, "Ready"
end

-- UnlockedAttacks format is not documented: try JSON, then comma list. INFERRED.
function Game.owned()
	local raw = Game.attr("UnlockedAttacks")
	if type(raw) ~= "string" or raw == "" then
		return nil
	end
	local set = {}
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
	if ok and type(decoded) == "table" then
		for k, v in pairs(decoded) do
			set[type(k) == "string" and k or tostring(v)] = true
		end
	else
		for name in raw:gmatch("[^,;|]+") do
			set[name:match("^%s*(.-)%s*$")] = true
		end
	end
	return set
end

function Game.copy(text)
	-- Executor-provided globals; plain nil when absent.
	local fn = (type(setclipboard) == "function" and setclipboard) or (type(toclipboard) == "function" and toclipboard) or nil
	if not fn then
		return false, "clipboard function not available"
	end
	local ok, err = pcall(fn, text)
	return ok, err
end

return Game
end
__sources["RollAdapter"] = function(require) -- src/RollAdapter.luau
-- Live adapter for AutoRoll. The roll request is the same zero-argument
-- RollAttack:InvokeServer() the game's own Roll button sends (UIController doRoll),
-- issued at most once per server cooldown. Nothing is forged or replayed.
local Game = require("Game")

return function()
	local adapter = {}

	adapter.now = os.clock
	adapter.wait = task.wait
	adapter.spawn = task.spawn
	adapter.canRoll = Game.rollStatus
	adapter.alive = Game.alive
	adapter.chanceOf = Game.chanceOf
	adapter.tierOf = Game.tierOf

	function adapter.readyAt()
		return Game.attr("RollReadyAt")
	end

	function adapter.currentStyle()
		return Game.equipped()
	end

	function adapter.requestRoll()
		local handle = { done = false }
		local remote = Game.rollRemote()
		if not remote then
			handle.done, handle.err = true, "RollAttack RemoteFunction not found (game updated?)"
			return handle
		end
		task.spawn(function()
			local ok, name, chance = pcall(remote.InvokeServer, remote)
			if ok then
				handle.name, handle.chance = name, chance
			else
				handle.err = tostring(name)
			end
			handle.done = true
		end)
		return handle
	end

	return adapter
end
end
__sources["RollObserver"] = function(require) -- src/RollObserver.luau
-- Roll Observer: passive, bounded capture of what happens during 2-3 MANUAL rolls.
-- Reads attributes and the game's own roll UI text only. Never invokes or hooks remotes.
-- Report excludes username, UserId and JobId.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Game = require("Game")
local Build = require("Build")

local MAX_EVENTS = 400
local RELEVANT = { "Roll", "Equipped", "Unlocked", "Luck", "FFA", "Confirm", "Boss", "Attack" }

local function relevant(name)
	for _, key in ipairs(RELEVANT) do
		if name:find(key, 1, true) then
			return true
		end
	end
	return false
end

local function short(v)
	local s = typeof(v) == "string" and v or tostring(v)
	if #s > 200 then
		s = s:sub(1, 200) .. ("...(%d chars)"):format(#s)
	end
	return s
end

local function capabilities()
	-- Presence check only; none of these are called except identifyexecutor.
	local probe = {
		{ "setclipboard", setclipboard },
		{ "toclipboard", toclipboard },
		{ "gethui", gethui },
		{ "identifyexecutor", identifyexecutor },
		{ "writefile", writefile },
		{ "firesignal", firesignal },
		{ "getconnections", getconnections },
		{ "hookmetamethod", hookmetamethod },
		{ "decompile", decompile },
	}
	local out = {}
	for _, p in ipairs(probe) do
		table.insert(out, ("%s=%s"):format(p[1], type(p[2]) == "function" and "yes" or "no"))
	end
	local exec = "unknown"
	if type(identifyexecutor) == "function" then
		local ok, a, b = pcall(identifyexecutor)
		if ok then
			exec = tostring(a) .. (b and (" " .. tostring(b)) or "")
		end
	end
	return exec, table.concat(out, " ")
end

return function(hubScope, log)
	local obs = { running = false, events = {}, dropped = 0, startedAt = nil, endsAt = nil, onUpdate = nil, header = "" }
	local cs

	local function push(kind, a, b)
		if #obs.events >= MAX_EVENTS then
			table.remove(obs.events, 1)
			obs.dropped += 1
		end
		table.insert(obs.events, ("+%7.3fs  %-8s %s%s"):format(os.clock() - obs.startedAt, kind, a, b and ("  " .. b) or ""))
		if obs.onUpdate then
			obs.onUpdate()
		end
	end

	local function snapshot()
		local lines = {}
		local ad, adErr = Game.attackData()
		local exec, caps = capabilities()
		table.insert(lines, ("Ervi Hub %s | Roll Observer report"):format(Build.id))
		table.insert(lines, ("PlaceId=%d PlaceVersion=%d (hub data from %d)"):format(game.PlaceId, game.PlaceVersion, Game.KNOWN_PLACE_VERSION))
		table.insert(lines, ("executor=%s"):format(exec))
		table.insert(lines, "capabilities: " .. caps)
		table.insert(lines, ("AttackData=%s styles=%d RollCooldown=%s MinRollCooldown=%s"):format(
			ad and "loaded" or ("MISSING (" .. tostring(adErr) .. ")"),
			#Game.styles(),
			tostring(ad and ad.RollCooldown),
			tostring(ad and ad.MinRollCooldown)
		))
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		local rr = remotes and remotes:FindFirstChild("RollAttack")
		table.insert(lines, ("Remotes.RollAttack=%s ForcedRoll=%s"):format(rr and rr.ClassName or "MISSING", tostring(remotes and remotes:FindFirstChild("ForcedRoll") ~= nil)))
		local ui = Game.mainUI()
		table.insert(lines, ("MainUI=%s RollRevealRoot=%s RollCooldown=%s"):format(
			tostring(ui ~= nil),
			tostring(ui and ui:FindFirstChild("RollRevealRoot") ~= nil),
			tostring(ui and ui:FindFirstChild("RollCooldown") ~= nil)
		))
		local ok, why = Game.rollStatus()
		table.insert(lines, ("rollStatus=%s (%s) serverNow=%.3f"):format(tostring(ok), why, Game.serverNow()))
		local names = {}
		for name, value in pairs(Game.player:GetAttributes()) do
			table.insert(names, name)
			if relevant(name) then
				table.insert(lines, ("  attr %s = %s"):format(name, short(value)))
			end
		end
		table.sort(names)
		table.insert(lines, ("all player attribute names (%d): %s"):format(#names, table.concat(names, ", ")))
		return table.concat(lines, "\n")
	end
	obs.snapshot = snapshot

	function obs.stop(reason)
		if not obs.running then
			return
		end
		obs.running = false
		if cs then
			cs:close()
			cs = nil
		end
		push("STOP", reason or "stopped")
		log("Diagnostics", "roll observer stopped: " .. (reason or "stopped"))
	end

	function obs.start(duration)
		obs.stop("restart")
		obs.events, obs.dropped = {}, 0
		obs.startedAt = os.clock()
		obs.endsAt = obs.startedAt + duration
		obs.header = snapshot()
		obs.running = true
		cs = hubScope:child("roll-observer")

		cs:connect(Game.player.AttributeChanged, function(name)
			if not relevant(name) then
				return
			end
			local v = Game.player:GetAttribute(name)
			local extra = nil
			if name:find("ReadyAt", 1, true) and type(v) == "number" then
				extra = ("(serverNow%+.3f)"):format(v - Game.serverNow())
			end
			push("ATTR", name .. " = " .. short(v), extra)
		end)

		local ui = Game.mainUI()
		local function watchText(inst, label, normalize)
			if not inst then
				push("MISSING", label)
				return
			end
			local last
			local function emit()
				local t = inst.Text
				local key = normalize and t:gsub("%d", "#") or t
				if key ~= last then
					last = key
					push("UI", label .. " = " .. short(t))
				end
			end
			emit()
			cs:connect(inst:GetPropertyChangedSignal("Text"), emit)
		end
		local reveal = ui and ui:FindFirstChild("RollRevealRoot")
		local panel = reveal and reveal:FindFirstChild("Panel")
		local button = ui and ui:FindFirstChild("RollButton")
		if reveal then
			push("UI", "RollRevealRoot.Visible = " .. tostring(reveal.Visible))
			cs:connect(reveal:GetPropertyChangedSignal("Visible"), function()
				push("UI", "RollRevealRoot.Visible = " .. tostring(reveal.Visible))
			end)
		else
			push("MISSING", "MainUI.RollRevealRoot")
		end
		watchText(panel and panel:FindFirstChild("Header"), "Panel.Header")
		watchText(panel and panel:FindFirstChild("Rarity"), "Panel.Rarity")
		watchText(button and button:FindFirstChild("Label"), "RollButton.Label")
		watchText(ui and ui:FindFirstChild("RollCooldown"), "RollCooldown", true) -- digits masked to skip countdown spam

		local h = Game.humanoid()
		if h then
			cs:connect(h.Died, function()
				push("CHAR", "Humanoid.Died")
			end)
		end

		local timer = task.delay(duration, function()
			obs.stop(("time limit %ds reached"):format(duration))
		end)
		cs:add(function()
			if coroutine.status(timer) ~= "dead" then
				pcall(task.cancel, timer)
			end
		end)
		push("START", ("capture %ds, max %d events"):format(duration, MAX_EVENTS))
		log("Diagnostics", "roll observer started")
	end

	function obs.report()
		local body = table.concat(obs.events, "\n")
		return ("%s\n--- events (%d kept, %d dropped) ---\n%s\n--- end ---"):format(obs.header ~= "" and obs.header or snapshot(), #obs.events, obs.dropped, body)
	end

	return obs
end
end
__sources["Session"] = function(require) -- src/Session.luau
-- Session helpers, each off by default and toggled from the Session tab:
--   Anti-AFK        When Roblox reports you idle (Player.Idled, roughly every 2 minutes while idle),
--                   send one harmless right-click through VirtualUser - the widely used method.
--                   VirtualUser needs executor permission (LocalUserSecurity).
--   Auto-reconnect  When Roblox shows a disconnect error, rejoin this place (up to 5 tries, 10 s apart).
--                   Only for connection / server errors - never after a kick, ban or security disconnect.
--                   Watches both the error event and the on-screen error prompt, because an idle drop
--                   may not raise the event (DevForum report).
--   Re-run after teleport  queue_on_teleport runs Ervi_Hub.luau from the executor workspace after
--                   teleports and rejoins while the flag file says "on". Nothing goes in autoexec.
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local TeleportService = game:GetService("TeleportService")

local HUB_FILE = "Ervi_Hub.luau"
local FLAG_FILE = "Ervi_Hub_autoexec.txt"

local RECONNECT_ON = {
	DisconnectErrors = true,
	DisconnectTimeout = true,
	DisconnectConnectionLost = true,
	DisconnectIdle = true,
	DisconnectRaknetErrors = true,
	DisconnectReceivePacketError = true,
	DisconnectReceivePacketStreamError = true,
	DisconnectSendPacketError = true,
	DisconnectEvicted = true,
	DisconnectDevMaintenance = true,
	DisconnectRobloxMaintenance = true,
	ReplicatorTimeout = true,
}

local function queueFn()
	if type(queue_on_teleport) == "function" then
		return queue_on_teleport
	elseif type(queueonteleport) == "function" then
		return queueonteleport
	end
	return nil
end

local function fileExists(name)
	if type(isfile) ~= "function" then
		return false
	end
	local ok, exists = pcall(isfile, name)
	return ok and exists == true
end

return function(hubScope, log)
	local player = Players.LocalPlayer
	local s = {
		HUB_FILE = HUB_FILE,
		QUEUED = ('if isfile and readfile and isfile("%s") and readfile("%s") == "on" and isfile("%s") then loadstring(readfile("%s"))() end'):format(
			FLAG_FILE,
			FLAG_FILE,
			HUB_FILE,
			HUB_FILE
		),
		antiAfk = false,
		reconnect = false,
		autoExec = false,
		afkPulses = 0,
		lastAfk = nil,
		reconnectStatus = "off",
		autoExecStatus = "off",
	}
	local afkScope, rcScope

	function s.setAntiAfk(on)
		if on == s.antiAfk then
			return
		end
		s.antiAfk = on
		if afkScope then
			afkScope:close()
			afkScope = nil
		end
		if not on then
			return
		end
		afkScope = hubScope:child("anti-afk")
		local ok, vu = pcall(game.GetService, game, "VirtualUser")
		if not ok or not vu then
			log("AntiAFK", "VirtualUser unavailable: " .. tostring(vu), true)
			return
		end
		afkScope:connect(player.Idled, function()
			local sent, err = pcall(function()
				vu:CaptureController()
				vu:ClickButton2(Vector2.new())
			end)
			if sent then
				s.afkPulses += 1
				s.lastAfk = os.clock()
			else
				log("AntiAFK", "could not send input: " .. tostring(err), true)
			end
		end)
	end

	function s.setReconnect(on)
		if on == s.reconnect then
			return
		end
		s.reconnect = on
		if rcScope then
			rcScope:close()
			rcScope = nil
		end
		s.reconnectStatus = on and "watching for disconnects" or "off"
		if not on then
			return
		end
		local scope = hubScope:child("reconnect")
		rcScope = scope
		local busy = false
		local function onError()
			if busy or scope.closed then
				return
			end
			local ok, code = pcall(GuiService.GetErrorCode, GuiService)
			local name = ok and code and code.Name or "unknown"
			if name == "OK" then
				return
			end
			if not RECONNECT_ON[name] then
				s.reconnectStatus = "not rejoining after " .. name
				log("Reconnect", s.reconnectStatus)
				return
			end
			busy = true
			scope:add(task.spawn(function()
				for attempt = 1, 5 do
					s.reconnectStatus = ("%s - rejoining (try %d/5)"):format(name, attempt)
					log("Reconnect", s.reconnectStatus)
					local sent, err = pcall(TeleportService.Teleport, TeleportService, game.PlaceId, player)
					if not sent then
						log("Reconnect", "teleport failed: " .. tostring(err), true)
					end
					task.wait(10)
				end
				s.reconnectStatus = "gave up after 5 tries"
				busy = false
			end))
		end
		local evOk = pcall(function()
			scope:connect(GuiService.ErrorMessageChanged, onError)
		end)
		local promptOk, overlay = pcall(function()
			return game:GetService("CoreGui").RobloxPromptGui.promptOverlay
		end)
		if promptOk and overlay then
			scope:connect(overlay.ChildAdded, function(child)
				if child.Name == "ErrorPrompt" then
					task.wait(0.5) -- let Roblox set the error code first
					onError()
				end
			end)
		end
		if not evOk and not (promptOk and overlay) then
			s.reconnectStatus = "cannot watch disconnects in this executor"
			log("Reconnect", s.reconnectStatus, true)
		end
	end

	-- ok, reason
	function s.autoExecSupport()
		if not queueFn() then
			return false, "this executor has no queue_on_teleport"
		end
		if type(writefile) ~= "function" or type(readfile) ~= "function" then
			return false, "this executor has no file access"
		end
		if not fileExists(HUB_FILE) then
			return false, HUB_FILE .. " is not in the executor workspace folder"
		end
		return true, "ready"
	end

	function s.setAutoExec(on)
		s.autoExec = on
		if type(writefile) == "function" then
			pcall(writefile, FLAG_FILE, on and "on" or "off")
		end
		if not on then
			s.autoExecStatus = "off"
			return
		end
		local ok, why = s.autoExecSupport()
		if not ok then
			s.autoExecStatus = "unavailable: " .. why
			return
		end
		local queued, err = pcall(queueFn(), s.QUEUED)
		s.autoExecStatus = queued and "on - Ervi Hub re-runs after the next teleport or rejoin" or ("queue failed: " .. tostring(err))
	end

	function s.stop()
		s.setAntiAfk(false)
		s.setReconnect(false)
	end

	return s
end
end
__sources["Prompts"] = function(require) -- src/Prompts.luau
-- Instant proximity prompts: when Roblox shows you a prompt (or you start holding one), set its
-- HoldDuration to 0 and keep it there. Turning the feature off restores every prompt it changed.
-- Event-driven via ProximityPromptService - no workspace-wide scan or DescendantAdded listener.
local ProximityPromptService = game:GetService("ProximityPromptService")

return function(hubScope, log)
	local p = { enabled = false, changed = 0 }
	local scope, originals

	local function apply(prompt)
		if not originals or originals[prompt] ~= nil or not prompt:IsA("ProximityPrompt") then
			return
		end
		originals[prompt] = prompt.HoldDuration
		prompt.HoldDuration = 0
		p.changed += 1
		scope:connect(prompt:GetPropertyChangedSignal("HoldDuration"), function()
			if prompt.HoldDuration ~= 0 then
				originals[prompt] = prompt.HoldDuration -- the game's newest intended value
				prompt.HoldDuration = 0
			end
		end)
	end

	function p.set(on)
		if on == p.enabled then
			return
		end
		p.enabled = on
		if on then
			scope = hubScope:child("instant-prompts")
			originals = setmetatable({}, { __mode = "k" })
			scope:connect(ProximityPromptService.PromptShown, apply)
			scope:connect(ProximityPromptService.PromptButtonHoldBegan, apply)
			log("Prompts", "instant prompts on")
			return
		end
		scope:close() -- stop re-zeroing first, then restore
		scope = nil
		local restored = 0
		for prompt, hold in pairs(originals) do
			if prompt.Parent and pcall(function()
				prompt.HoldDuration = hold
			end) then
				restored += 1
			end
		end
		originals = nil
		log("Prompts", ("instant prompts off, %d restored"):format(restored))
	end

	return p
end
end
__sources["App"] = function(require) -- src/App.luau
-- Ervi Hub (RNG RollAttacks) entry point.
-- Lifecycle: one hub Scope owns every GUI, connection and thread; features own child scopes.
-- The window X calls stopHub(), which nothing else can disconnect (fixes the old diagnostic X bug).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Build = require("Build")
local Scope = require("Scope")
local Theme = require("Theme")
local Ui = require("Ui")
local Game = require("Game")
local Rarity = require("Rarity")
local AutoRoll = require("AutoRoll")
local makeAdapter = require("RollAdapter")
local makeSafeZone = require("SafeZone")
local makeTargets = require("Targets")
local makeM1 = require("M1")
local makeObserver = require("RollObserver")
local Settings = require("Settings")
local makeSession = require("Session")
local makePrompts = require("Prompts")

local HUB_NAME = "RNG_RollAttacks_Hub"
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Stop previous runs: this hub, baseline v1 and older diagnostics.
for _, key in ipairs({ "RNG_HUB_STOP", "RNG_CYBORG_V6_STOP", "RNG_DIAG_V5_STOP" }) do
	local stop = _G[key]
	if type(stop) == "function" then
		pcall(stop)
	end
end
for _, name in ipairs({ HUB_NAME, "RNG_Cyborg_M1_V6", "RNG_AttackDiagnostic_V5", "RNG_Hub_CombatHUD", "RNG_Hub_M1HUD" }) do
	local old = playerGui:FindFirstChild(name)
	if old then
		old:Destroy()
	end
end

local hub = Scope.new("hub")
local stopped = false
local onStop = {} -- feature cleanups, registered as features are created

-- Registered before anything can yield (e.g. requiring game data), so a second Run always
-- finds and stops this one, even mid-load. A run stopped mid-load disposes whatever it adds later.
local function stopHub()
	if stopped then
		return
	end
	stopped = true
	for i = #onStop, 1, -1 do
		pcall(onStop[i])
	end
	hub:close()
	if _G.RNG_HUB_STOP == stopHub then
		_G.RNG_HUB_STOP = nil
	end
	print("[Ervi Hub] Fully stopped and cleaned.")
end
_G.RNG_HUB_STOP = stopHub

local logs = {}

local function log(feature, msg, isError)
	table.insert(logs, 1, ("%s %s: %s"):format(os.date("%H:%M:%S"), feature, msg))
	if #logs > 60 then
		table.remove(logs)
	end
	(isError and warn or print)(("[Ervi Hub] %s: %s"):format(feature, msg))
end

local function safe(feature, fn)
	return function(...)
		local ok, err = xpcall(fn, debug.traceback, ...)
		if not ok then
			log(feature, tostring(err), true)
		end
	end
end

local function isKey(name)
	if name == "Unknown" or name == "Escape" then
		return false
	end
	local ok, kc = pcall(function()
		return Enum.KeyCode[name]
	end)
	return ok and kc ~= nil
end
local function inList(list)
	return function(name)
		return Theme.find(list, name) ~= nil
	end
end
local validators = {
	toggleKey = isKey,
	safeZoneKey = function(value) return value == "NONE" or isKey(value) end,
	theme = inList(Theme.PRESETS),
	accent = function(name)
		return name == "" or Theme.hex(name) ~= nil or Theme.find(Theme.ACCENTS, name) ~= nil
	end,
	font = inList(Theme.FONTS),
	textColor = function(name)
		return Theme.hex(name) ~= nil or Theme.find(Theme.TEXT_COLORS, name) ~= nil
	end,
	bgColor = function(name)
		return name == "" or Theme.hex(name) ~= nil
	end,
}

-- Configs: the active config auto-saves every change; the autoload config (if set) is active at start.
local store = Settings.load(validators)
local activeName = store.autoload or Settings.DEFAULT_NAME
if not store.configs[activeName] then
	Settings.put(store, activeName, Settings.defaults())
end
local prefs = store.configs[activeName]
local syncs = {} -- each re-reads `prefs` into its control (after loading a config, a reset or a look change)
Ui.applyLook(prefs)
Ui.setOpacity(prefs.opacity, Settings.MIN_OPACITY)
local function savePrefs()
	local ok, err = Settings.save(store)
	if not ok and Settings.canPersist() then
		log("Settings", "could not save: " .. tostring(err), true)
	end
end

local metrics = { fps = 0, ping = 0 }
do
	local frames, since = 0, os.clock()
	hub:connect(RunService.Heartbeat, function()
		frames += 1
		local now = os.clock()
		if now - since >= 1 then
			metrics.fps = math.floor(frames / (now - since) + 0.5)
			frames, since = 0, now
			local ok, p = pcall(player.GetNetworkPing, player)
			metrics.ping = ok and math.floor(p * 1000 + 0.5) or 0
		end
	end)
end

-- ===================================================================== window
local gui = hub:add(Ui.new("ScreenGui", {
	Name = HUB_NAME,
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 350,
	Parent = playerGui,
}))
Ui.root(gui)
local W, H, TH, SW = prefs.winW, prefs.winH, Theme.titleH, Theme.sidebarW -- W/H change with the resize grip
local HOME = UDim2.new(0.5, -W / 2, 0.5, -H / 2)
local window = Ui.new("Frame", {
	Size = UDim2.fromOffset(W, H),
	Position = HOME,
	BackgroundColor3 = Theme.bg,
	Parent = gui,
})
Ui.surface(window)
Ui.corner(window, 12)
Ui.stroke(window, Theme.stroke, 0.1)
local uiScale = Ui.new("UIScale", { Parent = window })

local titleBar = Ui.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, TH), Active = true, Parent = window })
local dot = Ui.new("Frame", { Size = UDim2.fromOffset(8, 8), Position = UDim2.new(0, 16, 0.5, -4), BackgroundColor3 = Theme.accent, Parent = titleBar })
Ui.corner(dot, 4)
-- Brand title: silver serif with a dark outline; keeps its font and colors whatever look is chosen.
local title = Ui.text(titleBar, "Ervi Hub", { size = UDim2.new(0, 110, 1, 0), font = Theme.brandFont, textSize = 19, color = Color3.new(1, 1, 1) })
title.Position = UDim2.fromOffset(30, 0)
title:SetAttribute("FixedTextColor", true)
Ui.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(252, 252, 254), Color3.fromRGB(166, 168, 176)), Rotation = 90, Parent = title })
Ui.new("UIStroke", { Color = Color3.fromRGB(40, 40, 46), Thickness = 1.2, Parent = title }):SetAttribute("FixedBackground", true)
local subtitle = Ui.text(titleBar, ("v%s  ·  build %s"):format(Build.version, Build.id:sub(-12)), { size = UDim2.new(0, 260, 1, 0), textSize = Theme.size.tiny, color = Theme.faint, font = Theme.mono })
subtitle.Position = UDim2.fromOffset(146, 0)

local function titleButton(text, x, danger)
	local b = Ui.new("TextButton", {
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, x, 0.5, 0),
		Size = UDim2.fromOffset(30, 26),
		BackgroundColor3 = Theme.surface2,
		Text = text,
		TextColor3 = Theme.muted,
		TextSize = 18,
		Font = Theme.fontBold,
		Parent = titleBar,
	})
	Ui.corner(b)
	hub:connect(b.MouseEnter, function()
		b.BackgroundColor3 = danger and Theme.bad or Theme.hover
		b.TextColor3 = Theme.text
	end)
	hub:connect(b.MouseLeave, function()
		b.BackgroundColor3 = Theme.surface2
		b.TextColor3 = Theme.muted
	end)
	return b
end
local closeBtn = titleButton("×", -10, true)
local minBtn = titleButton("–", -46)
Ui.drag(hub, titleBar, window)

local body = Ui.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, TH), Size = UDim2.new(1, 0, 1, -TH), Parent = window })
local sidebar = Ui.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, SW, 1, 0), Parent = body })
Ui.pad(sidebar, 4, 10, 10, 10)
Ui.list(sidebar, 4)
local content = Ui.new("Frame", {
	BackgroundColor3 = Theme.surface,
	Position = UDim2.fromOffset(SW, 0),
	Size = UDim2.new(1, -SW - 10, 1, -10),
	ClipsDescendants = true,
	Parent = body,
})
Ui.surface(content)
Ui.corner(content, Theme.radius)

local userScale = prefs.scale
local function applyScale()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local fit = math.min((vp.X - 24) / W, (vp.Y - 24) / H)
	uiScale.Scale = math.max(0.5, math.min(userScale, fit))
end
applyScale()
if workspace.CurrentCamera then
	hub:connect(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), applyScale)
end

local minimized = false
local grip
local function setMinimized(on)
	minimized = on
	body.Visible = not on
	window.Size = UDim2.fromOffset(W, on and TH or H)
	minBtn.Text = on and "+" or "–"
	if grip then
		grip.Visible = not on
	end
end

-- Resize grip in the bottom-right corner: drag to resize; the size is saved in the active config.
local MIN_W, MIN_H, MAX_W, MAX_H = 520, 360, 1100, 820
grip = Ui.new("TextButton", {
	AutoButtonColor = false,
	BackgroundTransparency = 1,
	Text = "",
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -3, 1, -3),
	Size = UDim2.fromOffset(18, 18),
	ZIndex = 5,
	Parent = window,
})
grip:SetAttribute("ResizeGrip", true)
for i = 0, 2 do
	for j = 0, 2 - i do
		Ui.new("Frame", { Size = UDim2.fromOffset(2, 2), Position = UDim2.fromOffset(15 - 5 * i, 15 - 5 * j), BackgroundColor3 = Theme.faint, BorderSizePixel = 0, ZIndex = 5, Parent = grip })
	end
end
local function setWindowSize(w, h)
	W = math.clamp(math.floor(w), MIN_W, MAX_W)
	H = math.clamp(math.floor(h), MIN_H, MAX_H)
	if not minimized then
		window.Size = UDim2.fromOffset(W, H)
	end
end
do
	local resizing, startPos, startW, startH
	local function isPress(t)
		return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
	end
	hub:connect(grip.InputBegan, function(input)
		if isPress(input.UserInputType) then
			resizing, startPos, startW, startH = true, input.Position, W, H
		end
	end)
	hub:connect(UserInputService.InputChanged, function(input)
		local t = input.UserInputType
		if resizing and (t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch) then
			local s = uiScale.Scale -- mouse moves in screen pixels; the window is scaled
			setWindowSize(startW + (input.Position.X - startPos.X) / s, startH + (input.Position.Y - startPos.Y) / s)
		end
	end)
	hub:connect(UserInputService.InputEnded, function(input)
		if resizing and isPress(input.UserInputType) then
			resizing = false
			prefs.winW, prefs.winH = W, H
			savePrefs()
			applyScale()
		end
	end)
end
hub:connect(minBtn.Activated, function()
	setMinimized(not minimized)
end)
-- Toggle key. While `onKeyCaptured` is set, the next keyboard key is captured instead (Esc cancels).
local toggleKey = Enum.KeyCode[prefs.toggleKey]
local onKeyCaptured
local onSafeKey
hub:connect(UserInputService.InputBegan, function(input, processed)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	if processed or UserInputService:GetFocusedTextBox() then return end
	if onKeyCaptured then
		local done = onKeyCaptured
		onKeyCaptured = nil
		done(input.KeyCode)
		return
	end
	if processed or UserInputService:GetFocusedTextBox() then
		return -- typing in chat or a text box
	end
	if input.KeyCode.Name == prefs.safeZoneKey and onSafeKey then
		onSafeKey()
	elseif input.KeyCode == toggleKey then
		window.Visible = not window.Visible
	end
end)

-- ===================================================================== tabs
local pages, order, refreshers = {}, 0, {}
local function selectPage(id)
	for key, p in pairs(pages) do
		local on = key == id
		p.page.Visible = on
		p.ind.Visible = on
		p.btn.BackgroundTransparency = on and 0 or 1
		p.lbl.TextColor3 = on and Theme.text or Theme.muted
		if on and p.onShow then
			p.onShow()
		end
	end
end

local function addPage(id, label)
	order += 1
	local btn = Ui.new("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = Theme.surface2,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 32),
		Text = "",
		LayoutOrder = order,
		Parent = sidebar,
	})
	Ui.corner(btn)
	local ind = Ui.new("Frame", { BackgroundColor3 = Theme.accent, Size = UDim2.fromOffset(3, 16), Position = UDim2.new(0, 0, 0.5, -8), Visible = false, Parent = btn })
	Ui.corner(ind, 2)
	local lbl = Ui.text(btn, label, { size = UDim2.new(1, -16, 1, 0), font = Theme.fontMedium, color = Theme.muted })
	lbl.Position = UDim2.fromOffset(14, 0)
	local page = Ui.scroll(content, { Visible = false })
	Ui.pad(page, 14, 16, 14, 14)
	Ui.list(page, 10)
	pages[id] = { page = page, btn = btn, ind = ind, lbl = lbl }
	hub:connect(btn.Activated, function()
		selectPage(id)
	end)
	return page, pages[id]
end

-- fn runs at 10 Hz while its page is visible; a refresher that errors is disabled after logging once.
local function onRefresh(id, name, fn)
	table.insert(refreshers, { id = id, name = name, fn = fn })
end

local function badge(ok, okText, badText)
	return ok and okText or badText, ok and Theme.good or Theme.bad
end

-- ===================================================================== features
local m1 = makeM1(hub, playerGui, function() return prefs end, savePrefs)
local safeZone = makeSafeZone(hub)
local targets = makeTargets(hub, function() return prefs end, safeZone)
local observer = makeObserver(hub, log)
local autoRoll = AutoRoll.new(makeAdapter(), { resumeAfterDeath = prefs.resumeAfterDeath })
table.insert(onStop, function()
	autoRoll:dispose()
end)
table.insert(onStop, function()
	observer.stop("hub closed")
end)
local session = makeSession(hub, log)
table.insert(onStop, session.stop)
session.setAntiAfk(prefs.antiAfk)
session.setReconnect(prefs.reconnect)
session.setAutoExec(prefs.autoExec)
local prompts = makePrompts(hub, log)
table.insert(onStop, function()
	prompts.set(false) -- restores the original hold times
end)
prompts.set(prefs.instantPrompts)
local runEndedAt

-- ===================================================================== Dashboard
local dash = addPage("dash", "Dashboard")
do
	local c1 = Ui.card(dash, "Your style", 1)
	local sStyle, sOdds, sTier, sCd = Ui.kv(c1, "Equipped", 1), Ui.kv(c1, "Odds", 2), Ui.kv(c1, "Rarity", 3), Ui.kv(c1, "M1 cooldown (game config)", 4)

	local c2 = Ui.card(dash, "Rolling", 2)
	local setPill = Ui.pill(c2, 1)
	local sNext, sLuck, sAuto = Ui.kv(c2, "Status", 2), Ui.kv(c2, "Luck attributes", 3), Ui.kv(c2, "Auto Roll", 4)

	local c3 = Ui.card(dash, "Hub health", 3)
	local hData, hRemote, hUi, hVer, hCyb = Ui.kv(c3, "Style data (AttackData)", 1), Ui.kv(c3, "Roll request (RollAttack)", 2), Ui.kv(c3, "Game roll UI (MainUI)", 3), Ui.kv(c3, "Place version", 4), Ui.kv(c3, "M1 HUD", 5)

	local c4 = Ui.card(dash, "Performance", 4)
	local pFps, pPing = Ui.kv(c4, "FPS", 1), Ui.kv(c4, "Ping", 2)

	local c5 = Ui.card(dash, "Recent log", 5)
	local logText = Ui.text(c5, "", { textSize = Theme.size.tiny, font = Theme.mono, color = Theme.muted, order = 1 })

	onRefresh("dash", "dashboard", function()
		local eq = Game.equipped()
		local style = eq and Game.style(eq.name)
		sStyle(eq and eq.name or "none", eq and Game.tierColor(eq.name, eq.chance) or Theme.muted)
		sOdds(eq and eq.chance and ("1 in %d"):format(eq.chance) or "-")
		sTier(eq and Game.tierOf(eq.name, eq.chance) or "-")
		sCd(style and style.Cooldown and ("%ss"):format(tostring(style.Cooldown)) or "-")

		local ok, why = Game.rollStatus()
		setPill(ok and "Ready to roll" or "Not ready", ok and "good" or "warn")
		sNext(why, ok and Theme.good or Theme.text)
		sLuck(("Luck %s · Trait %s"):format(tostring(Game.attr("Luck") or "-"), tostring(Game.attr("TraitLuck") or "-")))
		sAuto(autoRoll.state, autoRoll:isRunning() and Theme.info or Theme.muted)

		local ad, adErr = Game.attackData()
		hData(badge(ad ~= nil, ("%d styles"):format(#Game.styles()), "missing: " .. tostring(adErr)))
		hRemote(badge(Game.rollRemote() ~= nil, "found", "missing"))
		hUi(badge(Game.mainUI() ~= nil, "found", "missing"))
		local same = game.PlaceVersion == Game.KNOWN_PLACE_VERSION
		hVer(("%d (data from %d)"):format(game.PlaceVersion, Game.KNOWN_PLACE_VERSION), same and Theme.good or Theme.warn)
		hCyb(m1.enabled and "on" or "off", m1.enabled and Theme.good or Theme.muted)
		pFps(tostring(metrics.fps), metrics.fps >= 50 and Theme.good or metrics.fps >= 30 and Theme.warn or Theme.bad)
		pPing(("%d ms"):format(metrics.ping))
		Ui.set(logText, "Text", #logs > 0 and table.concat(logs, "\n", 1, math.min(6, #logs)) or "No events yet.")
	end)
end

-- ===================================================================== Auto Roll
local rollPage = addPage("roll", "Auto Roll")
do
	local target = { mode = "chance", min = 500 }
	local styleNames = {}

	local cT = Ui.card(rollPage, "Target", 1, "Auto Roll stops before any further roll as soon as a result meets this target.")
	local modeRow = Ui.row(cT, 1)
	local chanceBox = Ui.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = cT })
	Ui.list(chanceBox, 6)
	local styleBox = Ui.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Visible = false, Parent = cT })
	Ui.list(styleBox, 6)
	local summary = Ui.text(cT, "", { textSize = Theme.size.small, color = Theme.info, order = 4 })

	local modeChance, modeStyle
	local presetButtons = {}
	local function refreshTarget()
		Ui.select(modeChance, target.mode == "chance")
		Ui.select(modeStyle, target.mode == "style")
		chanceBox.Visible = target.mode == "chance"
		styleBox.Visible = target.mode == "style"
		for n, b in pairs(presetButtons) do
			Ui.select(b, target.mode == "chance" and target.min == n)
		end
		local t = target.mode == "chance" and target or { mode = "style", names = styleNames }
		if not Rarity.validTarget(t) then
			summary.Text = "Pick a target."
			return
		end
		local released, hits = 0, 0
		for _, s in ipairs(Game.styles()) do
			if not s.Unreleased then
				released += 1
				if Rarity.qualifies(t, s.Name, s.Chance) then
					hits += 1
				end
			end
		end
		summary.Text = ("Target: %s.  %s"):format(
			Rarity.describe(t),
			released > 0 and ("%d of %d released styles qualify."):format(hits, released) or "(style data unavailable - result odds come from the server reply)"
		)
	end

	modeChance = Ui.button(hub, modeRow, "Odds threshold", { width = 140 }, function()
		target = { mode = "chance", min = target.min or 500 }
		refreshTarget()
	end)
	modeStyle = Ui.button(hub, modeRow, "Exact style", { width = 140 }, function()
		target = { mode = "style", names = styleNames, min = target.min }
		refreshTarget()
	end)

	Ui.text(chanceBox, "Stop on any style whose odds are 1 in N or rarer (game Chance >= N).", { textSize = Theme.size.small, color = Theme.muted, order = 1 })
	local presetRow = Ui.row(chanceBox, 2)
	for i, n in ipairs({ 100, 195, 500, 1000, 2500, 5000 }) do
		presetButtons[n] = Ui.button(hub, presetRow, "1/" .. n, { width = 66, order = i }, function()
			target = { mode = "chance", min = n }
			refreshTarget()
		end)
	end
	local customRow = Ui.row(chanceBox, 3)
	Ui.text(customRow, "Custom N:", { size = UDim2.new(0, 70, 1, 0), textSize = Theme.size.small, color = Theme.muted })
	Ui.input(hub, customRow, "e.g. 750", { width = 110, order = 1 }, function(text)
		local n = tonumber(text)
		if n and n >= 1 then
			target = { mode = "chance", min = math.floor(n) }
		end
		refreshTarget()
	end)

	Ui.text(styleBox, "Stop only on these exact style names (comma separated, case-sensitive).", { textSize = Theme.size.small, color = Theme.muted, order = 1 })
	local styleCheck = Ui.text(styleBox, "", { textSize = Theme.size.small, color = Theme.warn, order = 3 })
	Ui.input(hub, styleBox, "e.g. Cyborg, Knockback Stick", { size = UDim2.new(1, 0, 0, Theme.rowH), order = 2 }, function(text)
		styleNames = {}
		local unknown = {}
		for raw in text:gmatch("[^,]+") do
			local name = raw:match("^%s*(.-)%s*$")
			if name ~= "" then
				styleNames[name] = true
				if #Game.styles() > 0 and not Game.style(name) then
					table.insert(unknown, name)
				end
			end
		end
		target = { mode = "style", names = styleNames }
		styleCheck.Text = #unknown > 0 and ("Not in the game's style list: " .. table.concat(unknown, ", ")) or ""
		refreshTarget()
	end)

	-- Run card
	local cR = Ui.card(rollPage, "Run", 2)
	local runRow = Ui.row(cR, 1, 32)
	local setStartEnabled, setStopEnabled, setContEnabled
	local setState = Ui.pill(cR, 2)
	local reason = Ui.text(cR, "", { textSize = Theme.size.small, order = 3 })
	local kRun, kSent, kGot, kLast, kReady = Ui.kv(cR, "Running for", 4), Ui.kv(cR, "Rolls sent", 5), Ui.kv(cR, "Results received", 6), Ui.kv(cR, "Last result", 7), Ui.kv(cR, "Readiness", 8)

	local function currentTarget()
		if target.mode == "style" then
			return { mode = "style", names = styleNames }
		end
		return target
	end
	local function startWith(opts)
		local ok, err = autoRoll:start(currentTarget(), opts)
		if not ok then
			reason.Text = err
		end
	end
	setStartEnabled = select(2, Ui.button(hub, runRow, "Start", { variant = "primary", width = 100 }, safe("AutoRoll", function()
		startWith(nil)
	end)))
	setStopEnabled = select(2, Ui.button(hub, runRow, "Stop", { variant = "danger", width = 100, order = 1 }, function()
		autoRoll:stop("Stopped by user")
	end))
	setContEnabled = select(2, Ui.button(hub, runRow, "Continue", { width = 120, order = 2 }, safe("AutoRoll", function()
		startWith({ acceptRare = true, keepStats = true })
	end)))

	local KIND = { Found = "good", Paused = "warn", Idle = "idle", Error = "bad" }
	local function syncRun()
		local running = autoRoll:isRunning()
		setState(autoRoll.state, KIND[autoRoll.state] or "info")
		reason.Text = autoRoll.reason
		setStartEnabled(not running)
		setStopEnabled(running)
		setContEnabled(autoRoll.state == "Paused")
		if not running and autoRoll.stats.startedAt and not runEndedAt then
			runEndedAt = os.clock()
		elseif running then
			runEndedAt = nil
		end
	end
	local loggedState
	autoRoll:onChange(function()
		syncRun()
		if autoRoll.state ~= loggedState then -- reason changes every tick while waiting; log states only
			loggedState = autoRoll.state
			log("AutoRoll", autoRoll.state .. " - " .. autoRoll.reason)
		end
	end)

	-- Options card
	local cO = Ui.card(rollPage, "Safety options", 3)
	Ui.toggle(hub, cO, "Pause on rare results below target", "Like the game's own \"You will lose X\" warning (rarer than 1/125): keeps the result and waits for Continue.", true, function(v)
		autoRoll.opts.pauseOnRare = v
	end, 1)
	Ui.toggle(hub, cO, "Stop on uncertainty", "Pause if the server's roll cooldown does not restart after a result.", true, function(v)
		autoRoll.opts.requireCooldownAdvance = v
	end, 2)
	local capRow = Ui.row(cO, 3)
	Ui.text(capRow, "Roll cap per run:", { size = UDim2.new(0, 120, 1, 0), textSize = Theme.size.small, color = Theme.muted })
	Ui.input(hub, capRow, "250", { width = 80, text = "250", order = 1 }, function(text, _)
		local n = tonumber(text)
		if n and n >= 1 then
			autoRoll.opts.maxRolls = math.floor(n)
		end
	end)

	local cH = Ui.card(rollPage, "Recent results", 4)
	local histText = Ui.text(cH, "No rolls yet.", { textSize = Theme.size.small, font = Theme.mono, color = Theme.muted, order = 1 })

	local cN = Ui.card(rollPage, "How it works", 5)
	Ui.text(cN, table.concat({
		"• Sends the same no-argument roll request the game's own Roll button sends, only when the game itself would allow a roll (alive, in the arena, cooldown finished, no roll animation or confirm open).",
		"• One request at a time, never retried. Timeouts, empty results or uncertain cooldowns pause instead of rolling again.",
		"• A qualifying result is kept: zero further rolls. Your current style is checked before the first roll.",
		"• The game's roll animation does not play for hub rolls; the result shows here and on the Roll button.",
		"• Status: NOT LIVE TESTED in the game yet. Logic is mock-tested offline.",
	}, "\n"), { textSize = Theme.size.small, color = Theme.muted, order = 1 })

	onRefresh("roll", "autoroll", function()
		syncRun()
		local s = autoRoll.stats
		local endT = autoRoll:isRunning() and os.clock() or runEndedAt
		kRun(s.startedAt and endT and ("%ds"):format(math.floor(endT - s.startedAt)) or "-")
		kSent(tostring(s.attempted))
		kGot(tostring(s.confirmed))
		local last = autoRoll.last
		kLast(last and ("%s · 1/%s · %s"):format(last.name, tostring(last.chance or "?"), last.tier) or "-", last and Game.tierColor(last.name, last.chance) or nil)
		local _, why = Game.rollStatus()
		kReady(why)
		local lines = {}
		for i = 1, math.min(8, #autoRoll.history) do
			local h = autoRoll.history[i]
			table.insert(lines, ("#%-4d %-18s 1/%-6s %s"):format(h.n, h.name, tostring(h.chance or "?"), h.tier))
		end
		Ui.set(histText, "Text", #lines > 0 and table.concat(lines, "\n") or "No rolls yet.")
	end)
	pages.roll.onShow = refreshTarget
	refreshTarget()
	syncRun()
end

