end
__sources["Registry"] = function(require) -- src/Registry.luau
local Locale=require("Locale")
local Registry={}
Registry.__index=Registry
function Registry.new() return setmetatable({entries={},serial=0},Registry) end
function Registry:prune()
 local alive={}
 for _,entry in ipairs(self.entries) do if not entry.control or entry.control.Parent then table.insert(alive,entry) end end
 self.entries=alive
end
function Registry:add(page,title,description,control,section)
 if self.serial%64==0 then self:prune() end
 self.serial+=1
 local e={page=page,title=title,description=description or "",control=control,section=section or title,id=self.serial}
 table.insert(self.entries,e); return e
end
function Registry:search(query,limit)
 self:prune()
 query=Locale.fold(query or ""):match("^%s*(.-)%s*$")
 if query=="" then return {} end
 local results={}
 for _,e in ipairs(self.entries) do
  if not e.control or e.control.Parent then
   local text=Locale.fold(e.title.." "..e.description.." "..e.section.." "..Locale.text(e.title,"RU"))
   local match=true
   for word in query:gmatch("%S+") do if not text:find(word,1,true) then match=false; break end end
   if match then table.insert(results,e) end
  end
 end
 table.sort(results,function(a,b)
  local aExact=Locale.fold(a.title)==query; local bExact=Locale.fold(b.title)==query
  if aExact~=bExact then return aExact end
  return a.id<b.id
 end)
 while #results>(limit or 12) do table.remove(results) end
 return results
end
return Registry
end
__sources["PropertyOverrides"] = function(require) -- src/PropertyOverrides.luau
-- Own only the properties explicitly written. Restore only if still our value,
-- preserving later changes made by the game or another feature.
local Overrides={}; Overrides.__index=Overrides
function Overrides.new() return setmetatable({entries={}},Overrides) end
function Overrides:set(key,object,property,value)
 local e=self.entries[key]
 if e and e.object~=object then self:clear(key); e=nil end
 if not e then e={object=object,property=property,original=object[property]}; self.entries[key]=e end
 local previous=e.written
 e.written=value
 e.writing=true
 local ok,err=pcall(function() object[property]=value;e.written=object[property] end)
 e.writing=false
 if not ok then e.written=previous;error(err,0) end
end
function Overrides:clear(key)
 local e=self.entries[key]; if not e then return end
 self.entries[key]=nil
 pcall(function() if e.object[e.property]==e.written then e.object[e.property]=e.original end end)
end
function Overrides:close()
 local keys={}; for key in pairs(self.entries) do table.insert(keys,key) end
 for _,key in ipairs(keys) do self:clear(key) end
end
return Overrides
end
__sources["VisualPolicy"] = function(require) -- src/VisualPolicy.luau
local Policy={}
function Policy.rate(selected)
 return selected=="Auto" and 60 or tonumber(selected) or 60
end
function Policy.eligible(p,c)
 if not c.alive or (p.visibilityMode and not c.clearLine) or c.distance>p.maxDistance then return false end
 return true
end
function Policy.budget(p,rank,tick)
 local full=rank<=p.fullRateTargets
 return full or tick%p.farTargetRate==0,rank<=p.skeletonBudget
end
function Policy.color(p,c)
 return p.markFriends and c.friend and p.friendColor or p.enemyColor
end
-- Keep legacy custom relation colors; only the former factory pink becomes white for chams.
function Policy.chamsColor(p,c)
 local tint=Policy.color(p,c)
 return tint=="#F0628E" and "#FFFFFF" or tint
end
return Policy
end
__sources["World"] = function(require) -- src/World.luau
local Overrides=require("PropertyOverrides")
local Game=require("Game")
return function(hub,getPrefs)
 local Lighting=game:GetService("Lighting")
 local world={status="Ready"}
 local owned=Overrides.new();hub:add(owned)
 local blur
 function world.setBlur(on)
  if on and not blur and not hub.closed then blur=Instance.new("BlurEffect");blur.Name="ErviBackgroundBlur";blur.Size=14;blur.Parent=Lighting
  elseif not on and blur then blur:Destroy();blur=nil end
 end
 hub:add(function() world.setBlur(false) end)
 local function option(key,on,object,property,value)
  local ok,err=pcall(function() if on then owned:set(key,object,property,value) else owned:clear(key) end end)
  if not ok then world.status=property.." unavailable: "..tostring(err) end
 end
 function world.resetCamera()
  local cam=workspace.CurrentCamera;local h=Game.humanoid()
  if cam and h then cam.CameraType=Enum.CameraType.Custom;cam.CameraSubject=h;world.status="Camera reset to your character"
  else world.status="Wait for character/camera" end
 end
 function world.apply()
  local p=getPrefs()
  option("bright",p.fullbright,Lighting,"Brightness",2)
  option("ambient",p.fullbright,Lighting,"Ambient",Color3.new(1,1,1))
  option("outdoor",p.fullbright,Lighting,"OutdoorAmbient",Color3.new(1,1,1))
  option("fogStart",p.noFog,Lighting,"FogStart",1000000);option("fogEnd",p.noFog,Lighting,"FogEnd",1000000)
  option("shadows",p.noShadows,Lighting,"GlobalShadows",false);option("time",p.customTime,Lighting,"ClockTime",p.timeOfDay%24)
  local atmos=Lighting:FindFirstChildOfClass("Atmosphere")
  if atmos then option("density",p.noFog,atmos,"Density",0);option("haze",p.noFog,atmos,"Haze",0)
  else owned:clear("density");owned:clear("haze") end
 end
 hub:connect(Lighting.ChildAdded,function(child) if child:IsA("Atmosphere") and getPrefs().noFog then world.apply() end end)
 return world
end
end
__sources["PlayerTools"] = function(require) -- src/PlayerTools.luau
local Game=require("Game")
local Scope=require("Scope")
local Overrides=require("PropertyOverrides")
local makeWindow=require("FloatingWindow")
local Ui=require("Ui")
return function(hub,parent,getPrefs,save)
 local tools={status="Character waiting",walkActive=false}
 local owned=Overrides.new(); hub:add(owned)
 local charScope,panelScope,window,label,panelToggle,panelSlider,panelMultiplier,panelMode
 function tools.applySpeed()
  local h=Game.humanoid(); local p=getPrefs()
  if h and h.Health>0 and p.walkEnabled then
   local old=owned.entries.speed
   local base=old and old.object==h and old.original or h.WalkSpeed
   local value=p.speedMode=="Multiply" and base*p.speedMultiplier or p.walkSpeed
   local ok,err=pcall(function() owned:set("speed",h,"WalkSpeed",value) end)
   tools.requested=value;tools.walkActive=ok
   if ok then tools.status=("Local speed %.1f; no server-correction fallback"):format(value)
   else owned:clear("speed");p.walkEnabled=false;tools.status="WalkSpeed unavailable: "..tostring(err);save() end
  else owned:clear("speed"); tools.walkActive=false; tools.status=h and "Character OK · normal movement" or "Character waiting" end
 end
 local function bind(char)
  if charScope then charScope:close() end
  owned:clear("speed"); tools.walkActive=false;tools.status=char and "Character loading" or "Waiting for respawn"
  if tools.refreshStatus then tools.refreshStatus() end
  if hub.closed then return end
  charScope=Scope.new("player-tools-character")
  local watched
  local function watch(h)
   if not h:IsA("Humanoid") or watched==h then return end
   watched=h
   tools.applySpeed()
   charScope:connect(h.Died,function() owned:clear("speed"); tools.walkActive=false; tools.status="Waiting for respawn";tools.refreshStatus() end)
   charScope:connect(h:GetPropertyChangedSignal("WalkSpeed"),function()
    local e=owned.entries.speed
    if e and not e.writing and h.WalkSpeed~=e.written then owned:clear("speed");tools.walkActive=false;getPrefs().walkEnabled=false;save();tools.status="Game changed requested speed; disabled without retry";tools.refreshStatus() end
   end)
  end
  if char then
   local h=char:FindFirstChildOfClass("Humanoid"); if h then watch(h) end
   charScope:connect(char.ChildAdded,watch)
  end
 end
 local function panel()
  local p=getPrefs()
  if not p.movementPanel then if panelScope then panelScope:close();panelScope=nil;window=nil end; return end
  if panelScope then window.refresh();panelToggle.set(p.walkEnabled,true);panelSlider.set(p.walkSpeed,true);panelMultiplier.set(p.speedMultiplier,true);panelMode.set(p.speedMode,true);panelSlider.node.Visible=p.speedMode=="Set";panelMultiplier.node.Visible=p.speedMode=="Multiply"; return end
  if hub.closed then return end
  panelScope=Scope.new("movement-panel")
  window=makeWindow(panelScope,parent,"Ervi_MovementPanel",function()
   local c=getPrefs(); return {x=c.movementX,y=c.movementY,w=c.movementW*c.movementSize,h=c.movementH*c.movementSize}
  end,function(r)
