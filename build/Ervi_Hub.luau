__sources["UiImages"] = function(require) -- src/UiImages.luau
-- Crisp logo/icon images without a published asset: the PNGs are embedded in the bundle (UiAssets),
-- written to the executor workspace at start and loaded with getcustomasset, so a GitHub-loaded
-- bundle needs no extra files. Any missing API, error or failed load returns nil and callers keep
-- their native fallback. Nothing is downloaded.
local Data = require("UiAssets")
local UiImages = { resolver = nil, cell = Data.cell, iconRects = Data.icons, logoSize = Data.logoSize }

local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local LOOKUP = {}
for i = 1, #ALPHABET do
	LOOKUP[ALPHABET:byte(i)] = i - 1
end

function UiImages.decode(text)
	local out, bits, count = table.create(#text * 3 // 4), 0, 0
	for i = 1, #text do
		local v = LOOKUP[text:byte(i)]
		if v then
			bits = bits * 64 + v
			count += 6
			if count >= 8 then
				count -= 8
				local byte = bits // 2 ^ count
				out[#out + 1] = string.char(byte)
				bits -= byte * 2 ^ count
			end
		end
	end
	return table.concat(out)
end

local cache = {}
local function load(name, base64)
	if UiImages.resolver then
		return UiImages.resolver(name)
	end
	if cache[name] ~= nil then
		return cache[name] or nil
	end
	cache[name] = false
	if type(getcustomasset) ~= "function" or type(writefile) ~= "function" then
		return nil
	end
	local ok, id = pcall(function()
		-- Root of the workspace (no folder API needed). Rewritten every start, so a partial or
		-- stale file heals itself; the PNG bytes always come from this bundle, never from disk.
		local file = ("Ervi_Hub_ui-%s-%s.png"):format(name, Data.version)
		writefile(file, UiImages.decode(base64))
		return getcustomasset(file)
	end)
	if ok and type(id) == "string" and id ~= "" and UiImages.loaded(id) then
		cache[name] = id
		return id
	end
	return nil
end

-- True only when the engine confirms it can draw the image; otherwise callers fall back to the
-- native logo/icons instead of showing an empty ImageLabel. Bounded wait (~3 s worst case).
function UiImages.loaded(id)
	local okService, provider = pcall(function() return game:GetService("ContentProvider") end)
	if not okService or not provider then
		return false
	end
	local status
	task.spawn(function()
		local fine = pcall(function()
			provider:PreloadAsync({ id }, function(_, result) status = result end)
		end)
		if status == nil then status = fine and "none" or "error" end
	end)
	for _ = 1, 180 do
		if status ~= nil then break end
		task.wait()
	end
	local okName, name = pcall(function() return status.Name end)
	return okName and name == "Success"
end

function UiImages.icons() return load("icons", Data.iconsPng) end
function UiImages.logo() return load("logo", Data.logoPng) end

return UiImages
end
__sources["SkeletonStroke"] = function(require) -- src/SkeletonStroke.luau
-- Presentation only: how a skeleton thickness preference is drawn with GUI Frames.
-- Studio check (2026-11-14): Frames thinner than 1 px are not drawn at all and fractional widths
-- above 1 px snap to whole pixels. Sub-pixel values therefore keep a 1 px line and convey the
-- thinner weight with coverage (opacity); 1 px and up round to whole pixels.
local SkeletonStroke = { MIN = 0.1, MAX = 3 }

-- -> coreWidth, coreTransparency, outlineWidth, outlineTransparency
function SkeletonStroke.resolve(thickness)
	local t = tonumber(thickness)
	if not t or t ~= t then
		t = 1
	end
	t = math.clamp(t, SkeletonStroke.MIN, SkeletonStroke.MAX)
	if t < 1 then
		-- The black outline fades with the core so it never outweighs a faint line.
		return 1, 1 - t, 3, 1 - t * 0.8
	end
	local width = math.floor(t + 0.5)
	return width, 0, width + 2, 0
end

function SkeletonStroke.describe(thickness)
	local t = math.clamp(tonumber(thickness) or 1, SkeletonStroke.MIN, SkeletonStroke.MAX)
	if t < 1 then
		return ("%.1f px"):format(t)
	end
	local width = math.floor(t + 0.5)
	return math.abs(t - width) < 0.05 and ("%.1f px"):format(t) or ("%.1f px · draws %d"):format(t, width)
end

return SkeletonStroke
end
__sources["MovementAttempt"] = function(require) -- src/MovementAttempt.luau
-- Observation state only. A local observation is never proof of server acceptance.
local Attempt={};Attempt.__index=Attempt
function Attempt.new()
 return setmetatable({busy=false,status="Idle"},Attempt)
end
function Attempt:begin(character,destination,move)
 if self.busy then return false,"Movement pending" end
 self.character=character;self.destination=destination;self.elapsed=0;self.seen=false
 self.busy=true;self.outcome="pending";self.status="Movement requested · observing position"
 local ok,err=pcall(move)
 if not ok then self.busy=false;self.outcome="failed";self.status="Movement failed: "..tostring(err);return false,self.status end
 return true
end
function Attempt:step(dt,character,alive,distance)
 if not self.busy then return end
 self.elapsed+=dt
 if character~=self.character or not alive then self:cancel("Character changed or died");return end
 if type(distance)~="number" or distance~=distance then self:cancel("Position unavailable");return end
 if distance<=6 then self.seen=true end
 if self.seen and distance>12 then self:cancel("Movement corrected or displaced · no retry");return end
 if self.elapsed>=0.8 then
  self.busy=false
  self.outcome=distance<=6 and "observed" or "rejected"
  self.status=distance<=6 and "Teleport observed locally · server/game acceptance unverified" or "Teleport rejected or not observed · no retry"
 end
end
function Attempt:cancel(reason)
 self.busy=false;self.outcome="cancelled";self.character=nil;self.destination=nil;self.status=reason or "Cancelled"
end
return Attempt
end
__sources["MovementTransport"] = function(require) -- src/MovementTransport.luau
local Game=require("Game")
local Attempt=require("MovementAttempt")
return function(hub,authority)
 local state=Attempt.new()
 local api={state=state,status="Idle",busy=false}
 local callback,epoch= nil,0
 local function finish()
  api.busy=false;api.status=state.status;api.outcome=state.outcome
  local done=callback;callback=nil
  if done then done(api.status,api.outcome) end
 end
 function api.setAuthority(adapter) authority=adapter end
 function api.cancel(reason,owner)
  if owner and api.owner~=owner then return end
  epoch+=1;state:cancel(reason);callback=nil;api.busy=false;api.status=state.status
 end
 function api.move(position,range,done,owner,surface)
  if api.busy or hub.closed then return false,"Movement pending or unloaded" end
  local char=Game.player.Character;local root=char and char:FindFirstChild("HumanoidRootPart")
  if not root or not Game.alive() then return false,"Wait for a living character" end
  if typeof(position)~="Vector3" or position.X~=position.X or position.Y~=position.Y or position.Z~=position.Z or math.max(math.abs(position.X),math.abs(position.Y),math.abs(position.Z))>1e7 then return false,"Invalid destination" end
  if range and (position-root.Position).Magnitude>range then return false,"Destination outside range" end
  if api.beforeMove then api.beforeMove(owner) end
  if Game.player.Character~=char or not root.Parent or not Game.alive() then return false,"Character changed before movement" end
  if root.Anchored then return false,"Release position hold before moving" end
  callback=done;api.busy=true;api.owner=owner
  local token=epoch
  if authority and authority.available then
   -- The owned fixture's protocol takes a ground hit, while saved positions
   -- and native MoveTo use a character position. The server validates it again.
   if not surface then
    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={char};params.IgnoreWater=true
    local hit=workspace:Raycast(position+Vector3.new(0,6,0),Vector3.new(0,-24,0),params)
    surface=hit and hit.Position
   end
   if not surface then api.busy=false;callback=nil;return false,"No landing surface for owned Studio server" end
   local accepted=authority.request("teleport",{position=surface,range=math.clamp(range or 500,10,500)},function(result)
    if token~=epoch or hub.closed then return end
    api.busy=false;callback=nil
    api.status=result.ok and "Owned Studio server acknowledged teleport" or tostring(result.message or "Server rejected movement")
    api.outcome=result.ok and "server-acknowledged" or "rejected"
    if done then done(api.status,api.outcome) end
   end)
   if not accepted then api.busy=false;callback=nil;return false,"Server request pending" end
   api.status="Waiting for owned Studio server";return true
  end
  local ok,reason=state:begin(char,position,function() char:MoveTo(position) end)
  api.status=state.status
  if not ok then callback=nil;api.busy=false;return false,reason end
  return true
 end
 hub:connect(game:GetService("RunService").Heartbeat,function(dt)
  if not state.busy then return end
  local char=Game.player.Character;local root=char and char:FindFirstChild("HumanoidRootPart")
  state:step(dt,char,Game.alive(),root and (root.Position-state.destination).Magnitude or math.huge)
  api.status=state.status
  if not state.busy then finish() end
 end)
 hub:connect(Game.player.CharacterRemoving,function() api.cancel("Waiting for respawn") end)
 hub:add(function() api.cancel("Unloaded") end)
 return api
end
end
__sources["PositionData"] = function(require) -- src/PositionData.luau
-- Bounded, data-only storage; never evaluates coordinates or names as code.
local P={}
function P.name(name)
 return type(name)=="string" and #name>=1 and #name<=24 and not name:find("[^%w _%-]") and name or nil
end
function P.point(place,x,y,z)
 if type(place)~="number" or place<0 or place%1~=0 then return nil end
 for _,v in ipairs({x,y,z}) do if type(v)~="number" or v~=v or math.abs(v)>1e7 then return nil end end
 if x==nil or y==nil or z==nil then return nil end
 return {place=place,x=x,y=y,z=z}
end
function P.decode(text)
 local result={}
 if type(text)~="string" or #text>8192 then return result end
 local count=0
 for row in text:gmatch("[^;]+") do
  local name,place,x,y,z=row:match("^([%w _%-]+),([^,]+),([^,]+),([^,]+),([^,]+)$")
  local point=P.point(tonumber(place),tonumber(x),tonumber(y),tonumber(z))
  if not P.name(name) or not point or result[name] then return {} end
  count+=1;if count>64 then return {} end
  result[name]=point
 end
 return result
end
function P.encode(points)
 local keys={};for name in pairs(points) do table.insert(keys,name) end;table.sort(keys)
 if #keys>64 then return nil end
 local rows={}
 for _,name in ipairs(keys) do
  local p=points[name]
  if not P.name(name) or type(p)~="table" or not P.point(p.place,p.x,p.y,p.z) then return nil end
  table.insert(rows,("%s,%.0f,%.9g,%.9g,%.9g"):format(name,p.place,p.x,p.y,p.z))
 end
 return table.concat(rows,";")
end
function P.expression(p) return ("Vector3.new(%.9g, %.9g, %.9g)"):format(p.x,p.y,p.z) end
return P
end
__sources["EmergencyState"] = function(require) -- src/EmergencyState.luau
local E={};E.__index=E
function E.new() return setmetatable({latched=false,status="Off"},E) end
function E:evaluate(enabled,configured,health,maxHealth,threshold)
 local valid=type(health)=="number" and type(maxHealth)=="number" and health==health and maxHealth==maxHealth and health<math.huge and maxHealth<math.huge and maxHealth>0
 if valid and health/maxHealth*100>threshold then self.latched=false end
 if not enabled then self.status="Off";return false end
 if not configured then self.status="Destination missing";return false end
 if not valid or health<=0 then self.status="Waiting for respawn";return false end
 local percent=health/maxHealth*100
 if percent>threshold then self.latched=false;self.status="Ready";return false end
 if self.latched then return false end
 self.latched=true;self.status="Triggered";return true
end
function E:reset() self.latched=false;self.status="Waiting for respawn" end
return E
end
