   direction=cam.CFrame.LookVector*(down("W")-down("S"))+cam.CFrame.RightVector*(down("D")-down("A"))+Vector3.new(0,down("Space")-down("LeftControl"),0)
   if direction.Magnitude>1 then direction=direction.Unit end
