__sources["SliderValue"] = function(require) -- src/SliderValue.luau
local SliderValue={}
function SliderValue.normalize(value,lo,hi,step,fallback)
 local n=tonumber(value)
 if not n or n~=n or math.abs(n)==math.huge then return fallback end
 n=math.clamp(n,lo,hi)
 -- Round away float noise (0.1+2*0.1 = 0.30000000000000004) so values compare and save exactly.
 return math.clamp(math.round((lo+math.floor((n-lo)/step+0.5)*step)*1e6)/1e6,lo,hi)
end
function SliderValue.format(value,step)
 if step>=1 then return ("%d"):format(math.floor(value+0.5)) end
 return ("%.3f"):format(value):gsub("0+$",""):gsub("%.$","")
end
return SliderValue
end
__sources["Motion"] = function(require) -- src/Motion.luau
-- One owner per instance. Replaced transitions cannot run stale completion callbacks.
-- Factory injection lets tests exercise real interruption semantics without Roblox.
local Motion = {}
function Motion.new(create)
 local active = {}
 local api = {reduced=false, speed=1, closed=false}
 local function release(node, settle)
  local entry=active[node]
  if not entry then return end
  active[node]=nil
  if entry.connection then entry.connection:Disconnect() end
  if entry.tween then entry.tween:Cancel() end
  if settle then
   for key,value in pairs(entry.goal) do node[key]=value end
   if entry.done then entry.done() end
  end
 end
 function api.cancel(node) release(node,false) end
 function api.finish()
  local nodes={};for node in pairs(active) do table.insert(nodes,node) end
  for _,node in ipairs(nodes) do release(node,true) end
 end
 function api.to(node,goal,duration,done,style)
  if api.closed then return end
  local previous=active[node]
  -- Finish unrelated properties when replacing a combined transition.
  if previous then
   for key,value in pairs(previous.goal) do if goal[key]==nil then node[key]=value end end
  end
  release(node,false)
  local function immediate()
   for key,value in pairs(goal) do node[key]=value end
   if done then done() end
  end
  if api.reduced or not create or duration==0 then immediate();return end
  local ok,tween=pcall(create,node,(duration or 0.12)/api.speed,goal,style)
  if not ok or not tween then immediate();return end
  local entry={tween=tween,goal=goal,done=done}
  active[node]=entry
  entry.connection=tween.Completed:Connect(function()
   if active[node]~=entry then return end
   active[node]=nil
   entry.connection:Disconnect()
   if done then done() end
  end)
  tween:Play()
 end
 function api.configure(reduced,speed)
  api.speed=math.clamp(tonumber(speed) or 1,0.5,2)
  api.reduced=reduced==true
  if api.reduced then api.finish() end
 end
 function api.close()
  api.closed=true
  local nodes={};for node in pairs(active) do table.insert(nodes,node) end
  for _,node in ipairs(nodes) do release(node,false) end
 end
 return api
end
return Motion
end
__sources["Logo"] = function(require) -- src/Logo.luau
-- Prefers the antialiased PNG rendered from LogoGeometry (UiImages); native scanlines are the
-- fallback when the executor cannot provide a local image asset.
local Geometry = require("LogoGeometry")
local UiImages = require("UiImages")
local Logo = { POLYGONS = Geometry.polygons }
local roots = setmetatable({}, { __mode = "k" })
local images = setmetatable({}, { __mode = "k" })
local tint = Color3.new(1, 1, 1)

function Logo.refresh(background)
	local _, _, value = background:ToHSV()
	tint = value > 0.65 and Color3.fromRGB(21, 19, 24) or Color3.new(1, 1, 1)
	for image in pairs(images) do
		image.ImageColor3 = tint
	end
	for root, strips in pairs(roots) do
		if root.Parent then
			for _, strip in ipairs(strips) do
				strip.BackgroundColor3 = tint
			end
		end
	end
end

function Logo.create(parent, size)
	local requested = size or UDim2.fromOffset(26, Geometry.heightForWidth(26))
	local root = Instance.new("Frame")
	root.Name = "ErviOfficialLogo"
	root.BackgroundTransparency = 1
	root.Size = UDim2.new(
		requested.X.Scale,
		requested.X.Offset,
		requested.X.Scale / Geometry.aspectRatio,
		requested.X.Offset / Geometry.aspectRatio
	)
	-- Offset dimensions are quantized by Roblox. Keep the rendered ratio exact,
	-- with width explicitly authoritative rather than the parent's height.
	local aspect = Instance.new("UIAspectRatioConstraint")
	aspect.AspectRatio = Geometry.aspectRatio
	aspect.DominantAxis = Enum.DominantAxis.Width
	aspect.AspectType = Enum.AspectType.ScaleWithParentSize
	aspect.Parent = root
	root.Parent = parent

	local imageId = UiImages.logo()
	if imageId then
		local image = Instance.new("ImageLabel")
		image.Name = "LogoImage"
		image.BackgroundTransparency = 1
		image.Size = UDim2.fromScale(1, 1)
		image.Image = imageId
		image.ImageColor3 = tint
		image.ScaleType = Enum.ScaleType.Fit
		image:SetAttribute("FixedBackground", true)
		image.Parent = root
		images[image] = true
		return root
	end

	local strips = {}
	local displayWidth = math.max(1, requested.X.Offset)
	local rows = Geometry.rowsForWidth(displayWidth)
	for _, polygon in ipairs(Geometry.polygons) do
		for row = 0, rows - 1 do
			local y = (row + 0.5) * Geometry.height / rows
			local left, right = Geometry.spanAt(polygon, y)
			if left and right then
				local a, b, edge = Geometry.featherSpan(left, right, displayWidth)
				local strip = Instance.new("Frame")
				strip.BorderSizePixel = 0
				strip.BackgroundColor3 = tint
				strip:SetAttribute("FixedBackground", true)
				strip.Position = UDim2.fromScale(a / Geometry.width, row / rows)
				strip.Size = UDim2.fromScale((b - a) / Geometry.width, 1 / rows + 0.0001)
				local coverage = Instance.new("UIGradient")
				coverage.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(edge, 0),
					NumberSequenceKeypoint.new(1 - edge, 0),
					NumberSequenceKeypoint.new(1, 1),
				})
				coverage.Parent = strip
				strip.Parent = root
				strips[#strips + 1] = strip
			end
		end
	end
	roots[root] = strips
	return root
end

return Logo
end
__sources["StatusBar"] = function(require) -- src/StatusBar.luau
-- Compact fixed-height status pill: intrinsic chip layout replaces a resize handle.
-- It stays independent of main-window visibility and never disables features.
local Ui=require("Ui")
local Theme=require("Theme")
local Logo=require("Logo")
local Input=game:GetService("UserInputService")
local Run=game:GetService("RunService")
return function(hub,parent,getPrefs,save,restore,navigate,getState)
 local gui=hub:add(Ui.new("ScreenGui",{Name="Ervi_MinimizedStatus",IgnoreGuiInset=true,ResetOnSpawn=false,DisplayOrder=401,Enabled=false,Parent=parent}))
 Ui.root(gui)
 local frame=Ui.new("TextButton",{Name="ErviStatusPill",Text="",BackgroundColor3=Theme.surface,BackgroundTransparency=1-getPrefs().statusOpacity,AutoButtonColor=false,ClipsDescendants=true,Parent=gui})
 -- Liquid-glass pill: specular rim (UIStroke, still faded by statusOpacity) and soft luminance.
 Ui.corner(frame,19);local outline=Ui.glass(frame,0.4);outline.Transparency=0.25;Ui.sheen(frame,0.14)
 local mark=Logo.create(frame,UDim2.fromOffset(18,20));mark.Position=UDim2.fromOffset(8,9)
 local light=Ui.new("Frame",{Position=UDim2.fromOffset(32,16),Size=UDim2.fromOffset(6,6),BackgroundColor3=Theme.good,BorderSizePixel=0,Parent=frame});Ui.corner(light,3)
 local stats=Ui.text(frame,"",{size=UDim2.fromOffset(132,34),textSize=10,font=Theme.mono,align=Enum.TextXAlignment.Right})
 stats.AnchorPoint=Vector2.new(1,0);stats.Position=UDim2.new(1,-23,0,2)
 Ui.text(frame,"↗",{size=UDim2.fromOffset(18,38),align=Enum.TextXAlignment.Center,textSize=14}).Position=UDim2.new(1,-20,0,0)
 local dragging,pointer,start,travel
 local gestureDragged=false
 local function activate(page)
  if gestureDragged or dragging and (travel or 0)>3 then return end
  restore();if page then navigate(page) end
 end
 local chipButtons={};local chipTargets={}
 for i=1,3 do
  local index=i
  chipButtons[i]=Ui.button(hub,frame,"",{width=62,height=26,textSize=9},function() activate(chipTargets[index] or "dash") end)
  chipButtons[i].TextTruncate=Enum.TextTruncate.AtEnd;chipButtons[i].TextWrapped=false
  chipButtons[i].Position=UDim2.fromOffset(44+(i-1)*66,6)
  chipButtons[i]:FindFirstChildOfClass("UICorner").CornerRadius=UDim.new(0,13)
 end
 local rect={}
 local function layout()
  local cam=workspace.CurrentCamera;local vp=cam and cam.ViewportSize or Vector2.new(1280,720)
  rect.w=math.max(80,math.min(420,vp.X-16));rect.h=math.min(38,vp.Y)
  rect.maxX=math.max(0,vp.X-rect.w);rect.maxY=math.max(0,vp.Y-rect.h)
  if not dragging then rect.x=rect.maxX*getPrefs().statusX;rect.y=rect.maxY*getPrefs().statusY end
  frame.Size=UDim2.fromOffset(rect.w,rect.h);frame.Position=UDim2.fromOffset(rect.x,rect.y)
 end
 local function update()
  layout()
  local opacity=math.clamp(getPrefs().statusOpacity or 0.7,0,1)
  frame.BackgroundTransparency=1-opacity
  outline.Transparency=1-opacity*0.75
  local state=getState();local entries=state.features
  local capacity=math.clamp(math.floor((rect.w-206)/66),0,3)
  for i,button in ipairs(chipButtons) do
   button.BackgroundTransparency=1-opacity*0.45
   button.Visible=i<=capacity and i<=#entries
   if button.Visible then
    local overflow=#entries>capacity and i==capacity
    local label=overflow and ("+"..(#entries-capacity+1)) or entries[i].label
    if button.Text~=Ui.localeText(label) then
     Ui.set(button,"Text",label);button.TextTransparency=0.65
     Ui.animate(button,{TextTransparency=Ui.textAlpha},0.16)
    end
    chipTargets[i]=overflow and "dash" or entries[i].page
   end
  end
  stats.Size=UDim2.fromOffset(math.min(132,math.max(50,rect.w-54)),34)
  Ui.set(stats,"Text",("%d FPS · %d ms\nRoll: %s"):format(state.fps,state.ping,state.rollState))
  frame:SetAttribute("AutoRollState",state.rollState)
 end
 -- A gesture only exists while the pill is visible and the button is held. A release that never reaches
 -- the game (Esc menu, focus loss, hidden pill) cancels the gesture instead of leaving it armed, which
 -- previously moved the hidden pill with later mouse movement and saved it on the next click anywhere.
 local function cancelGesture()
  if not dragging then return end
  dragging=false;gestureDragged=false;travel=0
  layout()
 end
 local function beginGesture(input)
  if not gui.Enabled then return end
  if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
   dragging=true;gestureDragged=false;pointer=input.Position;start={x=rect.x,y=rect.y};travel=0
  end
 end
 hub:connect(frame.InputBegan,beginGesture)
 for _,button in ipairs(chipButtons) do hub:connect(button.InputBegan,beginGesture) end
 hub:connect(Input.InputChanged,function(input)
  if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
   if not gui.Enabled or (input.UserInputType==Enum.UserInputType.MouseMovement and not Input:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)) then cancelGesture();return end
   local dx,dy=input.Position.X-pointer.X,input.Position.Y-pointer.Y;travel=math.max(travel or 0,math.abs(dx)+math.abs(dy));if travel>3 then gestureDragged=true end
   rect.x=math.clamp(start.x+dx,0,rect.maxX);rect.y=math.clamp(start.y+dy,0,rect.maxY)
   frame.Position=UDim2.fromOffset(rect.x,rect.y)
  end
 end)
 hub:connect(Input.InputEnded,function(input)
  if dragging and (input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch) then
   dragging=false
   if gestureDragged and gui.Enabled then local p=getPrefs();p.statusX=rect.maxX>0 and rect.x/rect.maxX or 0;p.statusY=rect.maxY>0 and rect.y/rect.maxY or 0;save() end
  end
 end)
 hub:connect(frame.Activated,function() activate() end)
 hub:connect(Input.WindowFocusReleased,cancelGesture)
 local elapsed=0
 hub:connect(Run.Heartbeat,function(dt)
  if not gui.Enabled then return end
  elapsed+=dt;if elapsed>=0.25 then elapsed=0;update() end
 end)
 hub:connect(frame.MouseEnter,function() Ui.animate(frame,{BackgroundColor3=Theme.raised},0.12) end)
 hub:connect(frame.MouseLeave,function() Ui.animate(frame,{BackgroundColor3=Theme.surface},0.16) end)
 local scale=Ui.new("UIScale",{Parent=frame})
 hub:add(function() Ui.cancelAnimation(frame);Ui.cancelAnimation(scale) end)
 update()
 return {gui=gui,frame=frame,show=function(on)
  if not on then cancelGesture() end
  gui.Enabled=on
  if on then update();scale.Scale=0.94;Ui.animate(scale,{Scale=1},0.24,nil,"soft") end
 end,refresh=update}
end
end
__sources["BootLog"] = function(require) -- src/BootLog.luau
-- Actual initialization stages, bounded and optionally retained for the next run.
local Boot={};Boot.FILE="Ervi_Hub_boot.txt"
function Boot.new(build,now,read,write)
 local previous="Previous boot unavailable (no readable retained log)"
 if type(read)=="function" then local ok,text=pcall(read,Boot.FILE);if ok and type(text)=="string" then previous=text:sub(-32768) end end
 local self={lines={},started=now(),previous=previous}
 function self.step(message)
  table.insert(self.lines,("+%.3fs %s | %s"):format(now()-self.started,build,tostring(message):sub(1,500)))
  while #self.lines>80 do table.remove(self.lines,1) end
  if type(write)=="function" then pcall(write,Boot.FILE,table.concat(self.lines,"\n")) end
 end
 function self.text() return "Current boot\n"..table.concat(self.lines,"\n").."\n\nPrevious boot\n"..self.previous end
 return self
end
return Boot
end
